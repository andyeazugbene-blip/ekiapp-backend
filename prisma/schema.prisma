generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
  PAYMENT_SECURED
  VENDOR_CONFIRMED
  DISPUTED
  AUTO_RELEASED
}

enum EscrowType {
  NONE
  DOMESTIC_AFRICA
}

enum EscrowOtpChannel {
  SMS
  EMAIL
  SMS_EMAIL
}

enum UploadAssetStatus {
  REQUESTED
  COMPLETED
  FAILED
}

enum PaystackTxStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WalletTransactionType {
  PENDING_TO_AVAILABLE
  PAYMENT_PENDING_CREDIT
  PAYOUT_DEBIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // P0 fix (2026-09): a real Stripe Connect transfer attempt now sits
  // between APPROVED and PAID — PAID must mean the transfer actually
  // succeeded, never just that an admin clicked the button. Naming matches
  // the equivalent CampaignSupplierPayment.status states already used for
  // exactly this purpose in Community Buy.
  PROCESSING
  ON_HOLD
  PAID
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Community Buy Workstream 1 (identity/capability foundation, spec §6.4).
// Backfilled from the existing Vendor-dependent SupplierProfile's
// isVerified/isRestricted booleans (NOT_STARTED/UNDER_REVIEW/APPROVED/
// RESTRICTED only, for now) — DRAFT/VERIFICATION_REQUIRED/
// INFORMATION_REQUIRED/PAUSED/SUSPENDED/CLOSED have no legacy equivalent
// yet and are reachable only via new code going forward (Workstream 3).
enum SupplierAccountState {
  NOT_STARTED
  DRAFT
  VERIFICATION_REQUIRED
  UNDER_REVIEW
  INFORMATION_REQUIRED
  APPROVED
  PAUSED
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum PayoutMethodType {
  BANK_TRANSFER
  MOBILE_MONEY
  WISE
  PAYONEER
  OTHER
}

enum NotificationType {
  ORDER_PAID
  BALANCE_CREDITED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
  ADMIN_BROADCAST
  // Diaspora Expansion — Regular Deliveries. Sub-event is carried in
  // Notification.data.event (e.g. "renewal_upcoming", "payment_failed"),
  // matching the existing order_status sub-typing convention rather than
  // adding a new enum value per event.
  SUBSCRIPTION_UPDATE
  // Diaspora Expansion — Automation Engine. Sub-type is carried in
  // Notification.data.automationType.
  AUTOMATION_MESSAGE
  // Diaspora Expansion — Community Buy. Sub-event is carried in
  // Notification.data.event (e.g. "milestone_reached", "refund_started").
  COMMUNITY_CAMPAIGN_UPDATE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String
  // Nullable: an OAuth-only account (Google/Apple) has no Eki password.
  // authService.login() (email/password) explicitly rejects null rather
  // than letting bcrypt.compare receive it.
  password                 String?
  phone                    String?                   @unique
  avatar                   String?
  country                  String?
  referralCode             String?                   @unique
  referredBy               String?
  tokenVersion             Int                       @default(0)
  failedLoginAttempts      Int                       @default(0)
  lockedUntil              DateTime?
  isSuspended              Boolean                   @default(false)
  suspendedReason          String?
  emailVerifiedAt          DateTime?
  trustScore               Int                       @default(50)
  smsMarketingConsentAt    DateTime?
  smsTransactionalEnabled  Boolean                   @default(true)
  // Diaspora Expansion: consent for automated marketing messages (push +
  // email) sent by the Automation Engine — e.g. cart recovery, win-back,
  // review requests. Distinct from smsMarketingConsentAt (SMS-only) and
  // never gates transactional messages (order/payment status).
  marketingConsentAt       DateTime?
  role                     UserRole                  @default(BUYER)
  vendor                   Vendor?
  orders                   Order[]                   @relation("BuyerOrders")
  cart                     Cart?
  notifications            Notification[]
  purchasedGiftCards       PurchasedGiftCard[]
  adminTwoFactor           AdminTwoFactor?
  adminRoleAssignments     AdminRoleAssignment[]
  approvalsRequested       AdminApproval[]           @relation("AdminApprovalRequestedBy")
  approvalsDecided         AdminApproval[]           @relation("AdminApprovalDecidedBy")
  organiserProfile         OrganiserProfile?
  supplierAccount          SupplierAccount?
  buyerSubscriptions       BuyerSubscription[]
  buyerPaymentMethods      BuyerPaymentMethod[]
  automationRuns           AutomationRun[]
  campaignParticipations   CampaignParticipant[]
  communityBuySupportCases CommunityBuySupportCase[]
  oauthIdentities          OAuthIdentity[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([role, createdAt])
  @@index([createdAt])
  @@index([isSuspended])
}

// Google/Apple Sign-In (see docs/decisions/0008-oauth-sign-in.md). One row
// per linked provider identity — a user can link both Google and Apple to
// the same Eki account. providerUserId is the provider's stable, opaque
// subject identifier (Google's `sub` / Apple's `sub`), never the email —
// Apple's email can be a private-relay address that isn't a real identity.
model OAuthIdentity {
  id             String        @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Email as reported by the provider at link time — informational only,
  // never re-derived as the identity key. Nullable for Apple private relay.
  email          String?
  createdAt      DateTime      @default(now())

  @@unique([provider, providerUserId])
  @@unique([provider, userId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model Vendor {
  id                          String                    @id @default(cuid())
  userId                      String                    @unique
  storeName                   String                    @unique
  storeSlug                   String                    @unique
  description                 String?
  contactEmail                String?
  contactPhone                String?
  country                     String?
  city                        String?
  businessType                String?
  sellerRegion                String?
  currency                    String                    @default("EUR")
  avatar                      String?
  coverImage                  String?
  isSuspended                 Boolean                   @default(false)
  suspendedReason             String?
  stripeAccountId             String?                   @unique
  stripeAccountStatus         String?
  stripePayoutsEnabled        Boolean                   @default(false)
  stripeChargesEnabled        Boolean                   @default(false)
  stripeOnboardedAt           DateTime?
  verificationStatus          VendorVerificationStatus  @default(PENDING)
  stripeVerificationSessionId String?
  verifiedAt                  DateTime?
  verificationFailureReason   String?
  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                      Wallet?
  products                    Product[]
  orderItems                  OrderItem[]
  walletTransactions          WalletTransaction[]
  payoutMethods               PayoutMethod[]
  payoutRequests              PayoutRequest[]
  bankAccounts                VendorBankAccount[]
  promoCodes                  PromoCode[]
  bundles                     Bundle[]
  flashSales                  FlashSale[]
  supplierProfile             SupplierProfile?
  subscriptionOffers          SubscriptionOffer[]
  automationSettings          VendorAutomationSetting[]
  automationRuns              AutomationRun[]
  marketAssignments           VendorMarketAssignment[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([verificationStatus, createdAt])
  @@index([createdAt])
  @@index([isSuspended])
}

// A vendor's PRIMARY market stays `Vendor.country`/`Vendor.currency` (unchanged —
// every existing single-country call site keeps working against the primary
// market with zero behavior change). This table is the ADDITIVE layer: a vendor
// may hold more than one active assignment, each an independent approved launch
// market with its own resolved currency, so "UK + France" never collapses into
// one mixed value. `marketCode` is the canonical ISO code from
// shared/currency.ts's LAUNCH_MARKET_COUNTRIES — never a free-text country name —
// so gating code compares codes, not strings that can vary in spelling/case.
model VendorMarketAssignment {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  marketCode  String
  countryName String
  currency    String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorId, marketCode])
  @@index([vendorId, enabled])
  @@index([marketCode, enabled])
}

model PayoutMethod {
  id             String           @id @default(cuid())
  vendorId       String
  type           PayoutMethodType
  label          String?
  details        Json
  isDefault      Boolean          @default(false)
  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutRequests PayoutRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([vendorId])
}

model PayoutRequest {
  id                  String              @id @default(cuid())
  vendorId            String
  payoutMethodId      String
  amount              Int
  withdrawalFeeAmount Int                 @default(0)
  withdrawalFeeBps    Int                 @default(0)
  netAmount           Int?
  currency            String              @default("EUR")
  status              PayoutRequestStatus @default(PENDING)
  notes               String?
  rejectionReason     String?
  approvedById        String?
  approvedAt          DateTime?
  paidById            String?
  paidAt              DateTime?
  // Real Stripe Connect transfer id once a transfer actually succeeds —
  // never set speculatively. Null for manual (bank/PayPal) payout methods,
  // which have no provider transfer of ours to reference.
  stripeTransferId    String?
  // Why a PROCESSING transfer moved to ON_HOLD instead of PAID (provider
  // decline, timeout, vendor payout account not ready, etc.) — preserved
  // for admin review and safe retry, mirroring CampaignSupplierPayment.
  holdReason          String?
  vendor              Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payoutMethod        PayoutMethod        @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  walletTransactions  WalletTransaction[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([vendorId, status])
  @@index([status, createdAt])
}

model Product {
  id                        String                     @id @default(cuid())
  productCode               String?                    @unique
  vendorId                  String
  title                     String
  description               String?
  priceInCents              Int
  costAmount                Int?
  costCurrency              String?
  currency                  String                     @default("EUR")
  images                    String[]                   @default([])
  category                  String?
  stock                     Int                        @default(0)
  weightGrams               Int?
  isActive                  Boolean                    @default(true)
  vendor                    Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderItems                OrderItem[]
  cartItems                 CartItem[]
  subscriptionOfferProducts SubscriptionOfferProduct[]
  subscriptionItems         SubscriptionItem[]
  renewalItems              RenewalItem[]
  bundleItems               BundleItem[]
  flashSales                FlashSale[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([vendorId, title])
  @@index([productCode])
  @@index([vendorId, isActive])
  @@index([isActive, category])
  @@index([createdAt])
}

// One cart per buyer. A buyer may add products in different native
// currencies to the SAME cart — currency-safety is enforced at checkout
// time by backend FX normalization into one checkout currency (see
// fx-rates.ts / payments.service.ts), not by partitioning carts.
model Cart {
  id        String     @id @default(cuid())
  buyerId   String     @unique
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique @default(cuid())
  checkoutId            String?
  buyerId               String
  vendorId              String?
  status                OrderStatus          @default(PENDING)
  escrowType            EscrowType           @default(NONE)
  escrowExpiresAt       DateTime?
  vendorConfirmedAt     DateTime?
  disputedAt            DateTime?
  autoReleasedAt        DateTime?
  subtotalAmount        Int                  @default(0)
  deliveryFeeAmount     Int                  @default(0)
  platformFeeAmount     Int                  @default(0)
  vendorEarnings        Int                  @default(0)
  sellerPlanId          String?
  sellerPlanSlug        String?
  commissionTierId      String?
  commissionBps         Int?
  withdrawalFeeBps      Int?
  totalAmount           Int
  currency              String               @default("EUR")
  // Multi-currency checkout audit trail. `currency` above stays the
  // vendor's NATIVE currency for this order (unchanged — wallet/ledger
  // crediting still happens in it). These are only set when the buyer's
  // checkout currency differs from this order's native currency: the
  // authoritative, snapshotted conversion used to fold this order's
  // native total into the ONE currency actually charged via Stripe.
  // Never recomputed later — refunds must reference these exact values,
  // not a freshly fetched rate (see fx-rates.ts).
  checkoutCurrency      String?
  normalizedTotalAmount Int?
  exchangeRate          Float?
  exchangeRateTimestamp DateTime?
  exchangeRateSource    String?
  deliveryZoneId        String?
  deliveryAddress       String?
  notes                 String?
  deliveredAt           DateTime?
  checkout              Checkout?            @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  buyer                 User                 @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  deliveryZone          DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  sellerPlan            SellerPlan?          @relation(fields: [sellerPlanId], references: [id], onDelete: SetNull)
  commissionTier        CommissionTier?      @relation(fields: [commissionTierId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payment               Payment?
  paystackTransaction   PaystackTransaction?
  deliveryOtp           DeliveryOtp?
  dispute               Dispute?
  walletTransactions    WalletTransaction[]
  renewal               Renewal?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([checkoutId])
  @@index([buyerId, status])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@index([escrowType, status])
  @@index([sellerPlanId])
  @@index([commissionTierId])
  @@index([createdAt])
}

// `currency`/`totalAmount` here are the ONE checkout currency Stripe
// actually charges — the sum of every order's amount, each already
// normalized (see Order.normalizedTotalAmount) into this same currency
// when its own native currency differed. A mixed-currency cart (EUR +
// USD + GBP items) still produces exactly one Checkout, one currency,
// one PaymentIntent.
model Checkout {
  id                    String        @id @default(cuid())
  buyerId               String
  stripePaymentIntentId String?       @unique
  totalAmount           Int
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  processedAt           DateTime?
  orders                Order[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  vendorId     String
  quantity     Int
  unitAmount   Int
  totalAmount  Int
  costAmount   Int?
  costCurrency String?
  currency     String   @default("EUR")
  productTitle String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId])
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String              @unique
  // NOT unique: a multi-vendor checkout creates exactly ONE Stripe
  // PaymentIntent shared across every vendor's Order/Payment row (see
  // payments.service.ts createPaymentIntent) — Checkout.stripePaymentIntentId
  // is the actual unique identifier for "this PaymentIntent"; this field is
  // a denormalized copy for per-order lookups only. A unique constraint
  // here made the webhook's per-order update loop throw a P2002 starting
  // from the second order in any 2+-vendor Stripe checkout, leaving every
  // vendor after the first stuck PENDING despite the buyer having paid.
  stripePaymentIntentId String?
  amount                Int
  platformFeeAmount     Int
  vendorEarningsAmount  Int
  sellerPlanId          String?
  sellerPlanSlug        String?
  commissionTierId      String?
  commissionBps         Int?
  withdrawalFeeBps      Int?
  currency              String              @default("EUR")
  status                PaymentStatus       @default(PENDING)
  provider              String              @default("stripe")
  metadata              Json?
  processedAt           DateTime?
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerPlan            SellerPlan?         @relation(fields: [sellerPlanId], references: [id], onDelete: SetNull)
  commissionTier        CommissionTier?     @relation(fields: [commissionTierId], references: [id], onDelete: SetNull)
  walletTransactions    WalletTransaction[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([sellerPlanId])
  @@index([commissionTierId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([stripePaymentIntentId])
}

model Wallet {
  id               String              @id @default(cuid())
  vendorId         String              @unique
  pendingBalance   Int                 @default(0)
  availableBalance Int                 @default(0)
  currency         String              @default("EUR")
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  transactions     WalletTransaction[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletId        String
  vendorId        String
  orderId         String?
  paymentId       String?
  payoutRequestId String?
  type            WalletTransactionType
  amount          Int
  currency        String                @default("EUR")
  description     String?
  wallet          Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payoutRequest   PayoutRequest?        @relation(fields: [payoutRequestId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@unique([vendorId, orderId, paymentId, type])
  @@unique([payoutRequestId, type])
  @@index([walletId, createdAt])
  @@index([vendorId, createdAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([payoutRequestId])
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(cuid())
  buyerId     String
  vendorId    String
  productId   String?
  orderId     String
  rating      Int // 1-5
  comment     String?
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([buyerId, orderId, productId])
  @@index([vendorId, status])
  @@index([productId, status])
  @@index([buyerId])
  @@index([status, createdAt])
}

model DeliveryZone {
  id              String           @id @default(cuid())
  name            String
  country         String
  flag            String?
  baseFeeAmount   Int
  feePerKgAmount  Int
  currency        String           @default("EUR")
  isActive        Boolean          @default(true)
  vendorId        String?
  orders          Order[]
  renewals        Renewal[]
  deliveryMethods DeliveryMethod[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([country, isActive])
  @@index([vendorId, isActive])
}

model DeliveryMethod {
  id             String       @id @default(cuid())
  deliveryZoneId String
  label          String
  priceAmount    Int
  minDays        Int
  maxDays        Int
  isActive       Boolean      @default(true)
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([deliveryZoneId, isActive])
}

// ─── Phase 3: Shipment Tracking ─────────────────────────────────────────────

enum ShipmentStatus {
  PROCESSING
  IN_TRANSIT
  DELIVERED
  DELAYED
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  vendorId            String
  trackingNumber      String?
  carrier             String?
  status              ShipmentStatus @default(PROCESSING)
  estimatedDeliveryAt DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([vendorId, status])
  @@index([status])
  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  // Canonical business-identity key for idempotent creation — e.g.
  // "RENEWAL_REMINDER:{subscriptionId}:{isoDate}", the SAME identity used
  // for the corresponding AutomationRun.dedupeKey. Null for every
  // notification that doesn't need dedup (the overwhelming majority) —
  // Postgres allows unlimited NULLs under a unique index, so this is
  // purely additive. Enforced at the DB level so two concurrent sweeps for
  // the same event can never both succeed in creating a row, unlike an
  // application-level "check then create" which races.
  dedupeKey String?          @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

model WebhookEvent {
  id            String             @id @default(cuid())
  stripeEventId String             @unique
  eventType     String
  provider      String             @default("stripe")
  status        WebhookEventStatus @default(PROCESSING)
  paymentId     String?
  orderId       String?
  createdAt     DateTime           @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([eventType])
  @@index([paymentId])
  @@index([orderId])
}

enum FulfilmentAlertReason {
  // A real business date already on CampaignFulfilment.estimatedReadyAt
  // has passed while prep still isn't done — no invented threshold.
  PAST_ESTIMATED_READY_DATE
  // No estimatedReadyAt was ever set, so the only signal available is
  // "no progress for N hours" — real, but only ever fires when an admin
  // has configured FULFILMENT_STALE_THRESHOLD_HOURS; see fulfilment-delay
  // .service.ts. Never an invented default.
  STALE_NO_PROGRESS
}

enum FulfilmentAlertStatus {
  OPEN
  CONTACTED
  RESOLVED
  ESCALATED
}

/**
 * Admin supplier-fulfilment delay queue (architecture gap closure) — real findings from actual CampaignFulfilment rows.
 */
model SupplierFulfilmentAlert {
  id           String                @id @default(cuid())
  campaignId   String
  campaign     CommunityCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reason       FulfilmentAlertReason
  dedupeKey    String                @unique
  evidence     Json
  status       FulfilmentAlertStatus @default(OPEN)
  note         String?
  contactedAt  DateTime?
  resolvedById String?
  resolvedAt   DateTime?
  lastSeenAt   DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([campaignId])
}

enum PaymentAnomalyKind {
  DUPLICATE_PROVIDER_REF
  MULTIPLE_SUCCESSFUL_ATTEMPTS
  MISSING_LEDGER_ENTRY
}

enum PaymentAnomalyStatus {
  OPEN
  REVIEWED
  ESCALATED
}

/**
 * Admin duplicate-payment / financial-inconsistency queue (architecture
 * gap closure) — real findings from actual Payment/Checkout/
 * SubscriptionPaymentAttempt/CampaignChargeAttempt/LedgerEntry rows, never
 * fabricated. dedupeKey is a stable, deterministic key per finding (e.g.
 * "DUPLICATE_PROVIDER_REF:pi_xxx") so re-running the scan updates the same
 * row's evidence instead of creating duplicates, and a reviewed finding
 * stays reviewed across re-scans unless explicitly reopened.
 */
model PaymentAnomaly {
  id              String               @id @default(cuid())
  kind            PaymentAnomalyKind
  dedupeKey       String               @unique
  businessRefType String
  businessRefId   String
  evidence        Json
  status          PaymentAnomalyStatus @default(OPEN)
  reviewedById    String?
  reviewedAt      DateTime?
  note            String?
  lastSeenAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([kind])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Email OTP Verification ─────────────────────────────────────────────────

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("vendor_onboarding_email")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

// ─── Phase 2: Messaging ──────────────────────────────────────────────────────

enum ConversationType {
  BUYER_VENDOR
  ADMIN_VENDOR
  DISPUTE
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(BUYER_VENDOR)
  participantA  String
  participantB  String
  orderId       String?
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([participantA, participantB, orderId])
  @@index([participantA, lastMessageAt])
  @@index([participantB, lastMessageAt])
  @@index([orderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  attachments    String[]     @default([])
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Phase 2: Verification Documents ────────────────────────────────────────

enum VerificationDocType {
  GOVERNMENT_ID
  BUSINESS_REGISTRATION
  SELFIE
}

enum VerificationDocStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id              String                @id @default(cuid())
  vendorId        String
  type            VerificationDocType
  idType          String?
  frontUrl        String
  backUrl         String?
  status          VerificationDocStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  deleteAfterAt   DateTime?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([vendorId, type])
  @@index([status])
  @@index([deleteAfterAt, deletedAt])
  @@index([status, createdAt])
}

// ─── Phase 2: Buyer Addresses ───────────────────────────────────────────────

model BuyerAddress {
  id            String              @id @default(cuid())
  buyerId       String
  recipientName String
  line1         String
  line2         String?
  city          String
  postalCode    String
  country       String
  phone         String?
  isDefault     Boolean             @default(false)
  subscriptions BuyerSubscription[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([buyerId])
}

// ─── Phase 4: Audit Log ─────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  // Architecture-mandated audit fields (gap closure) — all nullable
  // because they're only populated where the calling code genuinely has
  // the information; a null here means "not captured for this call",
  // never a fabricated value. permissionUsed is set automatically by
  // requireAdminPermission (see middlewares/require-admin-permission.ts);
  // ipAddress is set automatically by recordAudit() when a request is
  // passed. beforeState/afterState/reason remain call-site-specific —
  // only meaningful for the specific mutations that snapshot them.
  permissionUsed String?
  beforeState    Json?
  afterState     Json?
  reason         String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─── Phase 5: Buyer Wallet ──────────────────────────────────────────────────

enum BuyerWalletTxType {
  TOP_UP
  REFERRAL_BONUS
  ORDER_DEBIT
  REFUND_CREDIT
  WITHDRAWAL
}

model BuyerWallet {
  id           String                   @id @default(cuid())
  buyerId      String                   @unique
  balance      Int                      @default(0)
  currency     String                   @default("EUR")
  transactions BuyerWalletTransaction[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model BuyerWalletTransaction {
  id              String            @id @default(cuid())
  walletId        String
  buyerId         String
  type            BuyerWalletTxType
  amount          Int
  currency        String            @default("EUR")
  description     String?
  orderId         String?
  paymentIntentId String?
  wallet          BuyerWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@unique([paymentIntentId, type])
  @@index([walletId, createdAt])
  @@index([buyerId, createdAt])
}

// ─── Phase 5: Promo Codes ───────────────────────────────────────────────────

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id             String            @id @default(cuid())
  vendorId       String
  code           String
  type           PromoType
  value          Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int               @default(0)
  validFrom      DateTime          @default(now())
  validUntil     DateTime?
  isActive       Boolean           @default(true)
  vendor         Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  redemptions    PromoRedemption[]
  bundle         Bundle?
  flashSale      FlashSale?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId, isActive])
  @@index([code, isActive])
  @@index([isActive, validFrom, validUntil])
}

// ─── Bundle / Flash Sale — real structured data (client mandate 2026-09) ──
// Previously these rode entirely on PromoCode, distinguished only by a
// string prefix on `code` ("BUNDLE"/"FLASH") with the actual name/price/
// currency/dates never persisted anywhere — only the derived discount
// amount survived, so list views had no way to show the real bundle price
// or sale price back to the vendor (they were hardcoded to 0). These models
// are now the source of truth for that real data. Checkout-time
// application is unchanged and still goes through the same, already-
// proven PromoCode redemption path (promoCodeId) — this is additive
// structure, not a rewrite of the working discount-redemption mechanism.
model Bundle {
  id               String       @id @default(cuid())
  vendorId         String
  name             String
  bundlePriceMinor Int
  currency         String
  isActive         Boolean      @default(true)
  promoCodeId      String?      @unique
  vendor           Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  promoCode        PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items            BundleItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([vendorId, isActive])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bundleId, productId])
  @@index([productId])
}

model FlashSale {
  id             String     @id @default(cuid())
  vendorId       String
  productId      String
  salePriceMinor Int
  currency       String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean    @default(true)
  promoCodeId    String?    @unique
  vendor         Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  product        Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([vendorId, isActive])
  @@index([productId])
  @@index([startsAt, endsAt])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  buyerId        String
  orderId        String?
  discountAmount Int
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())

  @@unique([promoCodeId, buyerId])
  @@index([buyerId])
}

// ─── Phase 5: Referrals ─────────────────────────────────────────────────────

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String    @unique
  bonusAmount Int
  currency    String    @default("EUR")
  creditedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId])
}

// ─── Phase 5: Rewards & Gifts ────────────────────────────────────────────────

enum RewardType {
  DISCOUNT_COUPON
  WALLET_BONUS
