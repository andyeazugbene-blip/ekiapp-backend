  slug                   String               @unique
  name                   String
  description            String?
  legacyPlan             SubscriptionPlan?    @unique
  monthlyPriceCents      Int                  @default(0)
  currency               String               @default("GBP")
  stripePriceId          String?
  stripeProductId        String?
  defaultPlatformFeeBps  Int                  @default(1500)
