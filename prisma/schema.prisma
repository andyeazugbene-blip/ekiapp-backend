model SubscriptionPlanConfig {
  id                  String           @id @default(cuid())
  plan                SubscriptionPlan @unique
  slug                String           @unique
  name                String
  description         String?
  monthlyPriceCents   Int              @default(0)
  platformFeeBps      Int              @default(1000)
  currency            String           @default("GBP")
  maxProducts         Int              @default(10)
  maxImagesPerProduct Int              @default(3)
  maxOrders           Int?
  analytics           Boolean          @default(false)
  prioritySupport     Boolean          @default(false)
  flashSales          Boolean          @default(false)
  bundles             Boolean          @default(false)
  discounts           Boolean          @default(false)
  marketingTools      Boolean          @default(false)
  canReceiveOrders    Boolean          @default(true)
  isActive            Boolean          @default(true)
  displayOrder        Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isActive, displayOrder])
}

model SellerPlan {
  id                     String               @id @default(cuid())
  slug                   String               @unique
  name                   String
  description            String?
  legacyPlan             SubscriptionPlan?    @unique
  monthlyPriceCents      Int                  @default(0)
  currency               String               @default("GBP")
  stripePriceId          String?
  stripeProductId        String?
  defaultPlatformFeeBps  Int                  @default(1500)
  withdrawalFeeBps       Int                  @default(250)
  maxProducts            Int                  @default(10)
  maxImagesPerProduct    Int                  @default(3)
  maxOrders              Int?
  maxCoupons             Int?
  maxBundles             Int?
  analytics              Boolean              @default(false)
  prioritySupport        Boolean              @default(false)
  flashSales             Boolean              @default(false)
  bundles                Boolean              @default(false)
  discounts              Boolean              @default(false)
  marketingTools         Boolean              @default(false)
  customerDatabase       Boolean              @default(false)
  repeatBuyerMarketing   Boolean              @default(false)
  professionalStorefront Boolean              @default(false)
  orderManagement        Boolean              @default(true)
  storeLinkSharing       Boolean              @default(false)
  canReceiveOrders       Boolean              @default(true)
  isActive               Boolean              @default(true)
  isDefault              Boolean              @default(false)
  displayOrder           Int                  @default(0)
  deletedAt              DateTime?
  subscriptions          VendorSubscription[]
  commissionTiers        CommissionTier[]
  orders                 Order[]
  payments               Payment[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([isActive, deletedAt, displayOrder])
  @@index([legacyPlan])
  @@index([isDefault])
}

model CommissionTier {
  id               String     @id @default(cuid())
  sellerPlanId     String
  label            String?
  minSubtotalCents Int        @default(0)
  maxSubtotalCents Int?
  platformFeeBps   Int
  isActive         Boolean    @default(true)
  displayOrder     Int        @default(0)
  sellerPlan       SellerPlan @relation(fields: [sellerPlanId], references: [id], onDelete: Cascade)
  orders           Order[]
  payments         Payment[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([sellerPlanId, isActive, minSubtotalCents])
}

model UploadAsset {
  id          String            @id @default(cuid())
  ownerId     String
  category    String
  key         String            @unique
  publicUrl   String?
  contentType String
  sizeBytes   Int?
  status      UploadAssetStatus @default(REQUESTED)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId, category, status])
  @@index([status, createdAt])
}

model EscrowProviderConfig {
  id                    String           @id @default(cuid())
  country               String
  countryCode           String
  currency              String
  provider              String
  enabled               Boolean          @default(false)
  payoutSupported       Boolean          @default(false)
  otpChannel            EscrowOtpChannel @default(SMS)
  protectionWindowHours Int              @default(24)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([countryCode, currency, provider])
  @@index([enabled, countryCode])
}

model SmsDelivery {
  id               String   @id @default(cuid())
  to               String
  purpose          String   @default("transactional")
  provider         String   @default("africastalking")
  status           String
  providerResponse Json?
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([to, createdAt])
  @@index([status, createdAt])
  @@index([purpose, createdAt])
}

// ─── Push Notifications (Expo) ──────────────────────────────────────────────

// A push token identifies one device installation, not one user — the
// same physical device can only ever be logged into one account at a
// time. `token` is globally unique (not scoped to userId) so that
// re-registering the same token under a different user (logout, then a
// different account logs in on the same device) REPLACES the previous
// association instead of leaving a second row that would keep pushing
// notifications to a device the original user is no longer signed into.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A ticket Expo returned status "ok" for — accepted into Expo's queue, NOT
// proof APNs/FCM delivered it. Held here until checkPushReceipts() (an
// internal cron sweep) fetches the real receipt after a delay and reports
// the actual delivery outcome; rows are deleted once checked either way.
model PushTicket {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  token     String
  userId    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Domestic Africa Escrow ─────────────────────────────────────────────────

model PaystackTransaction {
  id               String           @id @default(cuid())
  orderId          String           @unique
  reference        String           @unique
  amount           Int
  currency         String           @default("NGN")
  status           PaystackTxStatus @default(PENDING)
  paystackResponse Json?
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([reference])
  @@index([orderId])
  @@index([status, createdAt])
}

model VendorBankAccount {
  id                    String   @id @default(cuid())
  vendorId              String
  bankName              String
  bankCode              String
  accountNumber         String
  accountName           String
  currency              String   @default("NGN")
  isDefault             Boolean  @default(false)
  paystackRecipientCode String?
  vendor                Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([vendorId])
}

model DeliveryOtp {
  id          String    @id @default(cuid())
  orderId     String    @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  confirmedAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([expiresAt])
}

enum DisputeStatus {
  OPEN
  RESOLVED_VENDOR
  RESOLVED_BUYER
  RESOLVED_PARTIAL
}

model Dispute {
  id           String        @id @default(cuid())
  orderId      String        @unique
  buyerId      String
  vendorId     String
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  fraudulent   Boolean       @default(false)
  refundAmount Int?
  resolvedById String?
  resolvedAt   DateTime?
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([buyerId])
  @@index([vendorId])
}

/**
 * A real Stripe chargeback (`charge.dispute.created` webhook, architecture
 * doc §15.3 "Chargebacks" queue) — distinct from the `Dispute` model above,
 * which is a buyer/vendor order complaint Eki resolves internally. This is
 * the card network disputing a charge with Stripe directly. Previously this
 * webhook only logged + emailed ops with no DB row, so there was no queue
 * an admin could actually open and work from. `status`/`reason` store
 * Stripe's own string values as-is rather than a locally-maintained enum,
 * since Stripe's own set of values can grow without needing a migration
 * here.
 */
model StripeDispute {
  id              String    @id @default(cuid())
  stripeDisputeId String    @unique
  paymentIntentId String?
  checkoutId      String?
  buyerId         String?
  amount          Int
  currency        String
  reason          String
  status          String
  note            String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([buyerId])
}

// ─── Admin Two-Factor Authentication ────────────────────────────────────────

model AdminTwoFactor {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String[] @default([])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Admin-Controlled Campaigns (Hot Deals / Gift Cards) ───────────────────

enum CampaignType {
  HOT_DEAL
  GIFT_CARD
}

enum CampaignDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Campaign {
  id         String       @id @default(cuid())
  name       String
  type       CampaignType
  active     Boolean      @default(true)
  priority   Int          @default(0)
  colorTheme String?
  title      String
  subtitle   String?
  image      String?
  startDate  DateTime?
  endDate    DateTime?

  // Eligibility rules — all optional, all enforced server-side
  minimumCartAmountCents Int?
  requiredProductIds     String[] @default([])
  requiredCategoryIds    String[] @default([])
  minimumOrders          Int?
  minimumSpendCents      Int?
  newCustomerOnly        Boolean  @default(false)

  // Discount applied at checkout when buyer is eligible (platform-funded, vendor payout unaffected)
  discountType  CampaignDiscountType?
  discountValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active, priority])
}

// ─── Communication Log ──────────────────────────────────────────────────────
model CommunicationLog {
  id            String   @id @default(cuid())
  recipientId   String
  recipientType String // BUYER, VENDOR, ADMIN
  eventKey      String
  channel       String // email, push, in_app, sms
  title         String
  body          String   @db.Text
  status        String   @default("SENT")
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([recipientId])
  @@index([eventKey])
  @@index([createdAt])
  @@index([recipientType, createdAt])
}

// ─── Communication Templates (DB-backed, editable by admin) ─────────────────
model CommunicationTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  title         String
  body          String   @db.Text
  channels      String[] @default([])
  recipientType String   @default("BUYER")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Scheduled Communications ───────────────────────────────────────────────
model ScheduledCommunication {
  id           String    @id @default(cuid())
  audience     String
  channel      String
  templateKey  String?
  subject      String
  body         String    @db.Text
  status       String    @default("SCHEDULED") // SCHEDULED, SENT, FAILED, CANCELLED
  scheduledFor DateTime
  sentAt       DateTime?
  createdBy    String
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([createdBy])
}

// ─── Content Reports & User Blocks ─────────────────────────────────────────

model ContentReport {
  id         String    @id @default(cuid())
  reporterId String
  targetType String // "review" | "message" | "product" | "store"
  targetId   String
  reason     String // "inappropriate" | "spam" | "harassment" | "fraud" | "other"
  details    String?
  status     String    @default("PENDING") // PENDING | REVIEWED | DISMISSED
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// ─── Community Buy support cases — doc Phase 9 ─────────────────────────
// Distinct from ContentReport (content moderation) and Dispute (tied 1:1
// to an Order, which a campaign contribution isn't). Needed fields the
// doc calls for that neither existing model has: an internal-notes vs
// customer-visible-response split, evidence, and an escalation flag.

enum SupportCaseType {
  PAYMENT_ISSUE
  REFUND_ISSUE
  FULFILMENT_ISSUE
  ORGANISER_CONDUCT
  SUPPLIER_CONDUCT
  OTHER
  // Phase 2 (organiser controls) — an organiser's general request to change
  // something about their own live campaign, filed through the existing
  // CommunityBuySupportCase model/admin-review flow rather than a new one.
  // Deliberately separate from CampaignExtensionRequest (rescue-window
  // extensions, unchanged) and from any future supplier negotiation state
  // machine — this is admin-reviewed free text only, no automatic effect
  // on the campaign itself.
  CAMPAIGN_CHANGE_REQUEST
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model CommunityBuySupportCase {
  id                      String            @id @default(cuid())
  campaignId              String
  participantId           String
  caseType                SupportCaseType
  description             String
  evidenceUrls            String[]          @default([])
  status                  SupportCaseStatus @default(OPEN)
  // Admin-only — never returned to the reporter.
  internalNotes           String?
  // Shown to the reporter once set.
  customerVisibleResponse String?
  escalated               Boolean           @default(false)
  escalatedAt             DateTime?
  resolvedById            String?
  resolvedAt              DateTime?
  campaign                CommunityCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  participant             User              @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([campaignId])
  @@index([participantId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ═══════════════════════════════════════════════════════════════════════
// DIASPORA EXPANSION — Automation Engine
//
// Message content/delivery/audit reuse the existing CommunicationTemplate
// + communicationService.send() + CommunicationLog infrastructure (see
// src/modules/communications). These models add only what that
// infrastructure does not already provide: per-vendor on/off toggles,
// and event→eligibility→dedupe→outcome tracking so the same trigger can
// never fire twice for the same recipient, and so failures/suppressions
// are auditable per the client spec.
// ═══════════════════════════════════════════════════════════════════════

enum AutomationType {
  FIRST_SALE
  CART_RECOVERY
  BUYER_WIN_BACK
  REVIEW_REQUEST
  LOW_STOCK_ALERT
  BUYER_REFERRAL
  // Vendor-controlled: triggers after a completed+delivered order to suggest
  // reordering — separate from CART_RECOVERY (abandoned cart) and
  // PAYMENT_RECOVERY (Regular Delivery payment failure).
  REORDER_REMINDER
  // Vendor-controlled: triggers when an ordinary marketplace checkout is
  // abandoned, incomplete, or finally fails — separate from PAYMENT_RECOVERY
  // which is exclusively a Regular Delivery payment-failure automation.
  // A real payment-status recheck runs immediately before send; if the
  // payment is now verified or still processing, no message is sent.
  CHECKOUT_PAYMENT_FOLLOW_UP
  // Managed by Eki — vendor cannot toggle these:
  PAYMENT_RECOVERY
  RENEWAL_REMINDER
  PRICE_APPROVAL_REMINDER
  // Community Buy campaign lifecycle — backend-triggered, no vendor toggle:
  CAMPAIGN_MILESTONE
  CAMPAIGN_DEADLINE
  CAMPAIGN_REFUND_UPDATE
}

enum AutomationRunStatus {
  QUEUED
  ELIGIBILITY_CHECK
  SCHEDULED
  SENT
  SUPPRESSED
  FAILED
  CANCELLED
}

model VendorAutomationSetting {
  id        String         @id @default(cuid())
  vendorId  String
  type      AutomationType
  enabled   Boolean        @default(true)
  // Per-type tunables (e.g. { reminderHours: 24 } for CART_RECOVERY,
  // { inactivityDays: 60 } for BUYER_WIN_BACK). Absent/null = defaults.
  config    Json?
  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([vendorId, type])
  @@index([vendorId])
}

model AutomationRun {
  id                 String              @id @default(cuid())
  type               AutomationType
  vendorId           String?
  recipientUserId    String
  status             AutomationRunStatus @default(QUEUED)
  // Prevents the same trigger firing twice for the same recipient, e.g.
  // "cart-recovery:{cartId}" or "renewal-reminder:{renewalId}". Enforced
  // at the DB level, not just in application logic.
  dedupeKey          String              @unique
  eligibleAt         DateTime            @default(now())
  scheduledFor       DateTime?
  sentAt             DateTime?
  suppressedReason   String?
  failureReason      String?
  // Attribution: link back to the order/cart/campaign this run influenced,
  // and the CommunicationLog row that actually delivered it.
  communicationLogId String?
  data               Json?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  recipient          User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([type, status])
  @@index([recipientUserId, type])
  @@index([vendorId, type, createdAt])
  @@index([status, scheduledFor])
}

// ═══════════════════════════════════════════════════════════════════════
// DIASPORA EXPANSION — Regular Deliveries (buyer recurring foodstuff)
//
// Distinct from VendorSubscription/SellerPlan, which is the existing
// vendor SaaS billing system and is untouched by this domain.
//
// Offer, subscription, renewal and order are kept as four separate
// records per the spec: a renewal only produces a real Order (reusing
// the existing Order/OrderItem/Payment models) once its payment has been
// independently verified — an unpaid renewal is never visible to the
// vendor as an order.
// ═══════════════════════════════════════════════════════════════════════

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  EVERY_4_WEEKS
  MONTHLY
}

enum BuyerSubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  PAYMENT_ATTENTION
  CANCELLED
  EXPIRED
}

enum RenewalStatus {
  SCHEDULED
  AWAITING_STOCK
  AWAITING_PRICE_APPROVAL
  READY_FOR_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  PAID
  ORDER_CREATED
  SKIPPED
  CANCELLED
  EXPIRED
}

enum SubscriptionPaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// A buyer's saved, reusable Stripe payment method — does not exist
// anywhere in the current app (checkout today is always one-shot).
model BuyerPaymentMethod {
  id                    String                 @id @default(cuid())
  buyerId               String
  stripeCustomerId      String
  stripePaymentMethodId String                 @unique
  brand                 String?
  last4                 String?
  isDefault             Boolean                @default(false)
  buyer                 User                   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  subscriptions         BuyerSubscription[]
  campaignContributions CampaignContribution[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([buyerId])
}

model SubscriptionOffer {
  id                          String                     @id @default(cuid())
  vendorId                    String
  title                       String
  description                 String?
  frequencies                 SubscriptionFrequency[]
  substitutionPolicy          String?
  substitutionMode            OfferSubstitutionMode      @default(ASK_BUYER)
  renewalCutoffHours          Int                        @default(24)
  fulfilmentMethod            FulfilmentMethod           @default(DELIVERY)
  preparationHours            Int?
  // Percentage off the live product price applied at each renewal, e.g. 10
  // means renewals are charged at 90% of the product's current price. Null
  // means renewals use the plain current product price (spec §22 "Use
  // current product prices at each renewal").
  discountPercent             Int?
  // Copied onto BuyerSubscription.priceChangeApprovalLimitBps at subscribe
  // time (spec §22 "Maximum price increase without buyer approval") — null
  // leaves the subscription on the system default (renewals.service.ts).
  maxPriceIncreaseApprovalBps Int?
  isActive                    Boolean                    @default(true)
  // Distinct from isActive (unpublish removes the listing for new
  // subscribers). Pausing renewals keeps existing subscribers listed and
  // subscribed, it just stops new renewal cycles from being generated —
  // e.g. a vendor going away for two weeks without losing subscribers.
  renewalsPaused              Boolean                    @default(false)
  renewalsPausedAt            DateTime?
  vendor                      Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products                    SubscriptionOfferProduct[]
  subscriptions               BuyerSubscription[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([vendorId, isActive])
}

enum OfferSubstitutionMode {
  NO_SUBSTITUTION
  ASK_BUYER
  ALLOW_SIMILAR
}

model SubscriptionOfferProduct {
  id                    String            @id @default(cuid())
  offerId               String
  productId             String
  // spec §31 "Pause Product Renewals" — stops this product from being
  // included in any subscriber's future renewals without touching the
  // rest of their subscription or the offer's other products.
  pausedAt              DateTime?
  pauseReason           String?
  pauseExpectedReturnAt DateTime?
  offer                 SubscriptionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())

  @@unique([offerId, productId])
  @@index([productId])
}

model BuyerSubscription {
  id                          String                      @id @default(cuid())
  buyerId                     String
  offerId                     String
  status                      BuyerSubscriptionStatus     @default(DRAFT)
  frequency                   SubscriptionFrequency
  deliveryAddressId           String
  paymentMethodId             String?
  // Price-change auto-approval threshold, basis points. A proposed price
  // increase at or below this is auto-approved; above it requires the
  // buyer's explicit decision on the renewal (spec §6.6).
  priceChangeApprovalLimitBps Int                         @default(500)
  nextRenewalAt               DateTime?
  pausedUntil                 DateTime?
  cancelledAt                 DateTime?
  buyer                       User                        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  offer                       SubscriptionOffer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  deliveryAddress             BuyerAddress                @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  paymentMethod               BuyerPaymentMethod?         @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items                       SubscriptionItem[]
  renewals                    Renewal[]
  actionHistory               SubscriptionActionHistory[]
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([buyerId, status])
  @@index([offerId])
  @@index([status, nextRenewalAt])
}

model SubscriptionItem {
  id             String            @id @default(cuid())
  subscriptionId String
  productId      String
  quantity       Int               @default(1)
  subscription   BuyerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([subscriptionId, productId])
}

model Renewal {
  id                   String                       @id @default(cuid())
  subscriptionId       String
  // Uniqueness guard from spec §6.5: one renewal per subscription per
  // scheduled cycle date, enforced at the DB level.
  cycleDate            DateTime
  status               RenewalStatus                @default(SCHEDULED)
  stockConfirmedAt     DateTime?
  stockConfirmedById   String?
  priceChangeRequestId String?                      @unique
  subtotalAmount       Int?
  // Resolved and CHARGED at attemptPayment() time — never re-derived later
  // at order-conversion time, so what the buyer was actually charged can
  // never drift from what the Order/Payment rows record. Null only for a
  // COLLECTION-fulfilment offer (no delivery fee applies at all); for a
  // DELIVERY-fulfilment offer, attemptPayment() refuses to charge at all
  // if no matching zone exists rather than silently charging £0 delivery
  // (previously computed for the first time post-charge, defaulting to 0
  // when no zone existed).
  deliveryFeeAmount    Int?
  deliveryZoneId       String?
  currency             String                       @default("GBP")
  orderId              String?                      @unique
  failureReason        String?
  cancelledAt          DateTime?
  // Regular Delivery Admin Escalation — mirrors CampaignRefund's escalation
  // fields (same idempotency-marker pattern, not a new case system). There is
  // no participant-facing "case" entity for Regular Delivery to link to
  // (unlike CommunityBuySupportCase), so the escalation state lives directly
  // on the Renewal it concerns.
  escalated            Boolean                      @default(false)
  escalatedAt          DateTime?
  escalatedById        String?
  escalatedReason      String?
  subscription         BuyerSubscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order                Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  priceChangeRequest   PriceChangeRequest?          @relation("RenewalPriceChange", fields: [priceChangeRequestId], references: [id], onDelete: SetNull)
  deliveryZone         DeliveryZone?                @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items                RenewalItem[]
  paymentAttempts      SubscriptionPaymentAttempt[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([subscriptionId, cycleDate])
  @@index([status])
  @@index([subscriptionId, status])
}

model RenewalItem {
  id                String   @id @default(cuid())
  renewalId         String
  productId         String
  quantity          Int
  previousUnitPrice Int
  currentUnitPrice  Int
  currency          String   @default("GBP")
  stockAvailable    Boolean  @default(true)
  renewal           Renewal  @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([renewalId])
}

model PriceChangeRequest {
  id                   String    @id @default(cuid())
  previousUnitPrice    Int
  proposedUnitPrice    Int
  percentageDifference Float
  approvalLimitBps     Int
  approvalRequired     Boolean
  buyerDecision        String? // "accepted" | "declined" | null (pending)
  decidedAt            DateTime?
  renewal              Renewal?  @relation("RenewalPriceChange")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SubscriptionPaymentAttempt {
  id                    String                           @id @default(cuid())
  renewalId             String
  attemptNumber         Int
  status                SubscriptionPaymentAttemptStatus @default(PENDING)
  // Idempotency key sent to Stripe: "{renewalId}:{attemptNumber}" — see
  // spec §6.5. Unique at the DB level as a second line of defense.
  idempotencyKey        String                           @unique
  stripePaymentIntentId String?
  failureCode           String?
  failureMessage        String?
  renewal               Renewal                          @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@unique([renewalId, attemptNumber])
  @@index([renewalId])
}

model SubscriptionActionHistory {
  id             String            @id @default(cuid())
  subscriptionId String
  action         String // "created" | "paused" | "resumed" | "skipped_next" | "cancelled" | "edited"
  actorUserId    String?
  metadata       Json?
  subscription   BuyerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([subscriptionId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// DIASPORA EXPANSION — Community Buy (foundation)
//
// SCOPE NOTE: this is the role/campaign/review foundation only. The
// financial layer (contribution charging, refunds-at-scale, supplier
// settlement) is deliberately NOT built out yet — the client's own spec
// (§8.4) requires a country-by-country legal/payment-provider decision
// among three payment modes before any money can move, and
// community_buy_payments_enabled defaults to false for every market
// below. Mode A (pay-now/refund-on-failure) has a reference service
// implementation gated behind that flag; Modes B and C are not built.
// ═══════════════════════════════════════════════════════════════════════

// Client-corrected Community Buy flow: supplier is an optional fulfilment
// choice, never a prerequisite for publication — see CommunityCampaign
// below.
enum CampaignFulfilmentOwner {
  SELF
  SUPPLIER
}

// Community Buy Workstream 2 — organiser's stated delivery intent at
// creation time (spec §7 step 5). Collection-point is the safe default
// (spec §14.2). No address/courier data lives here — that's
// DeliveryReference, Workstream 5.
enum CampaignDeliveryPreference {
  COLLECTION
  DELIVERY
}

enum CampaignStatus {
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  LIVE
  PAUSED
  CLOSING
  RESCUE_WINDOW
  SUCCEEDED
  FAILED
  REFUNDING
  FULFILLING
  COMPLETED
  FINANCIALLY_CLOSED
  CANCELLED
  // Phase 4 (cancellation under review) — a campaign that has already
  // captured at least one PAID contribution (PLEDGE_THEN_CHARGE only)
  // enters this state instead of going straight to CANCELLED when the
  // organiser requests cancellation; see CampaignCancellationRequest.
  // Only ever entered from LIVE/PAUSED/RESCUE_WINDOW/FULFILLING/SUCCEEDED,
  // and only ever exits to CANCELLED (admin approval) or back to whichever
  // of those it came from (admin rejection, snapshotted as
  // CampaignCancellationRequest.preCancellationStatus).
  CANCELLATION_UNDER_REVIEW
  // M2 — AUTHORISE_THEN_CAPTURE-mode-only states (spec §6.3, §8, §11.3).
  // Additive: only ever entered by a campaign whose paymentMode is
  // AUTHORISE_THEN_CAPTURE (see CommunityCampaign.paymentMode) — a
  // PLEDGE_THEN_CHARGE campaign never reaches any of these, and its
  // existing LIVE -> RESCUE_WINDOW -> FULFILLING flow is untouched.
  HOLD_WINDOW // commitment locked; manual-capture holds being placed/monitored
  DECISION_REQUIRED // below minimum at decisionDeadline; organiser has 24h to proceed/cancel
  AWAITING_SUPPLIER_RECONFIRMATION // third-party supply proceeding below minimum; supplier must reconfirm
  PAYMENT_CAPTURE // capturing every hold_succeeded authorisation; -> FULFILLING once done
}

enum ContributionStatus {
  INITIATED
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  // PLEDGE_THEN_CHARGE states (client mandate 2026-09) — a payment method is
  // saved and the pledge is recorded, but no money moves until the campaign
  // succeeds. PAYMENT_PROCESSING is reused for "off-session charge attempt
  // in flight" once the campaign closes (see CampaignChargeAttempt).
  PLEDGED
  CHARGE_FAILED
  REFUND_PENDING
  REFUND_PROCESSING
  REFUNDED
  REFUND_FAILED
  CANCELLED
}

model OrganiserProfile {
  id                         String                        @id @default(cuid())
  userId                     String                        @unique
  isVerified                 Boolean                       @default(false)
  verifiedAt                 DateTime?
  // Admin risk control — doc §Risk Controls. Independent of isVerified: a
  // verified organiser can be temporarily restricted without revoking
  // verification (revocable, distinct from rejection).
  isRestricted               Boolean                       @default(false)
  restrictedReason           String?
  country                    String
  // Diaspora escrow reconciliation (final V1 settlement doc §N) — mirrors
  // supplier-stripe-connect.service.ts's Express-account pattern exactly.
  // Organisers never received a payout of any kind before this: the
  // organiser is now the primary commercial recipient of released Community
  // Buy proceeds (net of Eki's organiser commission), so they need their own
  // Connect destination, same as a SupplierAccount/Vendor already has.
  providerConnectedAccountId String?
  chargesEnabled             Boolean                       @default(false)
  payoutsEnabled             Boolean                       @default(false)
  detailsSubmitted           Boolean                       @default(false)
  // Phase 2 (organiser identity display preference) — controls whether
  // buyer-facing surfaces show this organiser's full name or first name
  // only. Defaults true (privacy-preserving default, matching this app's
  // existing "only fulfilment-necessary data" principle) — an existing
  // organiser who never touches this setting is shown as first-name-only,
  // same as a brand-new one.
  firstNameOnlyDisplay       Boolean                       @default(true)
  user                       User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns                  CommunityCampaign[]
  organiserPayouts           CommunityBuyOrganiserPayout[]
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
}

model SupplierProfile {
  id               String              @id @default(cuid())
  vendorId         String              @unique
  isVerified       Boolean             @default(false)
  verifiedAt       DateTime?
  isRestricted     Boolean             @default(false)
  restrictedReason String?
  country          String
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  campaigns        CommunityCampaign[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

// Community Buy Workstream 1 — target identity/capability model (spec §3,
// §6.4, §15.4). Additive: does NOT replace SupplierProfile, which stays the
// source of truth for existing Vendor-backed campaign assignment until
// Workstream 3 cuts CommunityCampaign.supplierId over to this table.
// userId-keyed by design — a supplier account never requires a Vendor.
model SupplierAccount {
  id                         String               @id @default(cuid())
  userId                     String               @unique
  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Bridges to the legacy Vendor-dependent SupplierProfile during the
  // Workstream 1-3 transition, when one exists — kept in sync by
  // syncSupplierAccountForProfile(), never authoritative on its own.
  legacySupplierProfileId    String?              @unique
  providerConnectedAccountId String?
  supplierState              SupplierAccountState @default(NOT_STARTED)
  chargesEnabled             Boolean              @default(false)
  payoutsEnabled             Boolean              @default(false)
  detailsSubmitted           Boolean              @default(false)
  requirementsDue            String[]             @default([])
  // M5 — Stripe's own `requirements.currently_due` array, distinct from
  // requirementsDue above (that one is Eki-side profile completeness —
  // categories/coverageRegions — computed by computeRequirementsDue(), not
  // this). Kept separate rather than overloading the existing field's
  // established meaning. Synced by getStatus()'s live Stripe poll.
  stripeRequirementsDue      String[]             @default([])
  categories                 String[]             @default([])
  coverageRegions            String[]             @default([])
  collectionAreas            String[]             @default([])
  // M5 (spec §10.2 step 5: "Collect coverage areas, collection capacity,
  // product categories and fulfilment evidence separately") — the one
  // onboarding field named in the spec that never got a column. Nullable:
  // "not yet stated," never a fabricated default.
  collectionCapacityPerDay   Int?
  approvedAt                 DateTime?
  pausedAt                   DateTime?
  // M5 — SUSPENDED/CLOSED were reachable in the enum since Workstream 1 but
  // no code ever set them (see supplier-account.service.ts's own comment).
  // Additive timestamps, mirroring approvedAt/pausedAt's existing pattern.
  suspendedAt                DateTime?
  closedAt                   DateTime?
  controlScope               String?
  reasonCode                 String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  // Workstream 3 — campaigns this account is assigned to directly (the
  // no-Vendor-required path). A campaign with a legacy-linked account is
  // dual-written onto CommunityCampaign.supplierId too; see supplierId's
  // own comment for why both can be set at once during the transition.
  campaigns                  CommunityCampaign[]

  @@index([supplierState])
}

enum SupplierInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// Workstream 3 — the third supply route deferred from Workstream 2: an
// organiser inviting someone with no existing Eki account (or an existing
// account with no SupplierAccount yet) to supply a specific campaign.
// Accepting creates/links a SupplierAccount only — never a Vendor, per the
// mandate's explicit "do NOT create a fake retail Vendor" instruction.
model SupplierInvitation {
  id                        String                   @id @default(cuid())
  campaignId                String
  campaign                  CommunityCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invitedByUserId           String
  email                     String
  token                     String                   @unique
  status                    SupplierInvitationStatus @default(PENDING)
  // Snapshot of the campaign's supply terms at invite time (title,
  // quantities, price, dates) — what the invitee is actually agreeing to,
  // immune to the organiser editing the campaign after sending the invite.
  termsSnapshot             Json
  declineReason             String?
  acceptedSupplierAccountId String?
  expiresAt                 DateTime
  respondedAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([campaignId])
  @@index([email])
}

model CommunityCampaign {
  id                        String                             @id @default(cuid())
  organiserId               String
  // Nullable — a campaign may be self-fulfilled by the organiser with no
  // supplier at all. When set, fulfilmentOwner is SUPPLIER; when null,
  // fulfilmentOwner is SELF. Supplier acceptance/decline is fulfilment
  // workflow state only and never gates publication/LIVE — see submit()
  // and publish() in community-campaigns.service.ts.
  supplierId                String?
  // Workstream 3 — additive expand-phase FK alongside supplierId, not a
  // replacement. New assignments write this; a legacy-linked SupplierAccount
  // (has legacySupplierProfileId) also dual-writes supplierId so every
  // existing campaign.supplier.vendor... read keeps working untouched. A
  // genuinely new no-Vendor supplier gets only this column. Resolve a
  // campaign's supplier through resolveCampaignSupplier() (supplier-
  // resolution.service.ts), never by reading either FK directly, so both
  // paths stay correct without duplicating logic at every call site.
  supplierAccountId         String?
  fulfilmentOwner           CampaignFulfilmentOwner            @default(SUPPLIER)
  title                     String
  description               String?
  // Community Buy Workstream 2: loosened from required to nullable so a
  // draft can exist before the organiser has decided these — real "not yet
  // chosen" (null), never a fabricated placeholder value. submit() is the
  // authoritative gate that requires all three before review (spec §7 —
  // "any authenticated user can create a draft; gates apply only when an
  // action creates supplier, payment or public obligations"). Existing
  // rows are unaffected; this is a pure nullability loosening.
  country                   String?
  currency                  String?
  targetAmount              Int
  // Diaspora escrow reconciliation (final V1 settlement doc §N) — the
  // organiser-agreed price paid to an Eki-registered verified supplier for
  // this campaign's goods, distinct from pricePerShareMinor (what
  // participants pay). Null means no Eki-mediated wholesale split applies:
  // self-supply, an external (non-Eki) supplier the organiser pays
  // privately, or a supplier-fulfilled campaign created before this field
  // existed — all three preserve releaseSupplierPayment()'s original
  // full-amount-to-supplier behavior exactly. Set only when fulfilmentOwner
  // is SUPPLIER; the supplier must see this (and their commission/net) at
  // invitation-accept time — see supplier-invitation acceptance.
  wholesaleAmountMinor      Int?
  deadline                  DateTime?
  status                    CampaignStatus                     @default(DRAFT)
  reviewNotes               String?
  reviewedById              String?
  reviewedAt                DateTime?
  publishedAt               DateTime?
  closedAt                  DateTime?
  paidTotal                 Int                                @default(0)
  // Flexible-fulfilment quantity model (minimum/goal/maximum shares) —
  // added alongside the original amount-based targetAmount rather than
  // replacing it, since existing reads of targetAmount (admin list views)
  // still work during the UI migration; all NEW campaign creation and
  // state-machine logic treats these as authoritative.
  minimumShares             Int?
  goalShares                Int?
  maximumShares             Int?
  // Phase 2 (organiser controls) — optional per-buyer slot limits, distinct
  // from the campaign-wide maximumShares cap above. Null means no per-buyer
  // limit (today's behavior, unchanged for every existing campaign).
  // Enforced in campaign-contributions.service.ts's pledge() alongside the
  // existing assertCapacityAvailable() check.
  perBuyerMinShares         Int?
  perBuyerMaxShares         Int?
  pricePerShareMinor        Int?
  // Community Buy Workstream 2 — Product step (spec §7 step 1). Additive;
  // pricePerShareMinor above stays the sole authoritative price, never
  // reinterpreted by these.
  images                    String[]                           @default([])
  unit                      String?
  quantityPerOrder          Int?
  qualityNotes              String?
  // Community Buy Workstream 2 — Delivery step (spec §7 step 5). This is
  // only the organiser's stated intent at creation time — no address,
  // courier token, or DeliveryReference (that's Workstream 5's privacy
  // infrastructure, deliberately untouched here).
  deliveryPreference        CampaignDeliveryPreference         @default(COLLECTION)
  // Phase 3 (address + privacy foundation) — the organiser's public
  // collection-point address, shown to every buyer once set. Required at
  // submit() only when deliveryPreference is COLLECTION. Not
  // privacy-sensitive (it's the organiser's own chosen public location,
  // same visibility as the campaign itself) — no privacy-service gating
  // needed, unlike a buyer's own delivery address below.
  collectionAddressLine1    String?
  collectionAddressLine2    String?
  collectionCity            String?
  collectionPostcode        String?
  // Phase 3 — coarse coverage areas (postcode/area prefixes, e.g. "SW1",
  // "E14") this campaign can deliver to. Only meaningful when
  // deliveryPreference is DELIVERY; required at submit() in that case.
  // A buyer's own postcode is checked against this list at pledge time
  // (assertDeliveryAddressWithinCoverage() in
  // campaign-contributions.service.ts) — empty means no coverage
  // configured yet, which blocks every delivery pledge until the
  // organiser sets at least one area.
  deliveryCoverageAreas     String[]                           @default([])
  // Phase 2 (organiser controls) — optional scheduled opening. Null means
  // publish() opens the campaign immediately (today's behavior, unchanged).
  // When set, publish() records publishedAt but leaves status APPROVED;
  // the existing community-buy-sweep cron (openScheduledCampaigns()) flips
  // it to LIVE once this time passes — no new campaign state introduced.
  scheduledOpenAt           DateTime?
  // Phase 2 (admin ops) — one shared free-text note for the admin unified
  // campaign-operations view. Deliberately separate from reviewNotes (which
  // is tied to the approve/reject/changes-requested workflow and is shown
  // to the organiser) — this is admin-internal-only and never surfaced to
  // the organiser or participants.
  adminIssueNotes           String?
  confirmedShares           Int                                @default(0)
  fundingOutcome            FundingOutcome                     @default(PENDING)
  supplierCommitted         Boolean                            @default(false)
  supplierCommittedAt       DateTime?
  // Distinct from CHANGES_REQUIRED (which always means "admin sent this
  // back to the organiser") — a supplier decline never touches campaign
  // status, since the organiser still needs to reassign a new supplier
  // (reassignSupplier() below) before doing anything else. Cleared on
  // reassignment so a fresh supplier starts from a clean slate.
  supplierDeclinedAt        DateTime?
  supplierDeclineReason     String?
  rescueDurationMinutes     Int                                @default(2880)
  rescueEndsAt              DateTime?
  extensionCount            Int                                @default(0)
  termsLockedAt             DateTime?
  // M2 — snapshotted ONCE at campaign creation from the market's
  // MarketConfiguration.communityBuyPaymentMode (defaulting to
  // PLEDGE_THEN_CHARGE when the market has no mode configured, which is
  // every market today — see communityCampaignsService.create()). Never
  // re-read from the market after creation: a later market-level flag
  // flip must not change an already-live campaign's payment mechanics
  // mid-flight (same immutable-snapshot principle as termsLockedAt).
  paymentMode               CommunityBuyPaymentMode            @default(PLEDGE_THEN_CHARGE)
  // AUTHORISE_THEN_CAPTURE-mode-only scheduling/decision fields (spec
  // §11.3, §8 step 7-9). Null/unused for PLEDGE_THEN_CHARGE campaigns.
  holdWindowStartsAt        DateTime?
  decisionDeadline          DateTime?
  decisionRequiredAt        DateTime?
  reconfirmationRequestedAt DateTime?
  reconfirmationDeadline    DateTime?
  reconfirmationQuantity    Int?
  organiser                 OrganiserProfile                   @relation(fields: [organiserId], references: [id], onDelete: Restrict)
  supplier                  SupplierProfile?                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierAccount           SupplierAccount?                   @relation(fields: [supplierAccountId], references: [id], onDelete: Restrict)
  participants              CampaignParticipant[]
  contributions             CampaignContribution[]
  extensionRequests         CampaignExtensionRequest[]
  cancellationRequests      CampaignCancellationRequest[]
  supplierPayment           CampaignSupplierPayment?
  organiserPayout           CommunityBuyOrganiserPayout?
  fulfilment                CampaignFulfilment?
  supportCases              CommunityBuySupportCase[]
  updates                   CampaignUpdate[]
  fulfilmentAlerts          SupplierFulfilmentAlert[]
  supplierInvitations       SupplierInvitation[]
  paymentAuthorisations     CommunityBuyPaymentAuthorisation[]
  payout                    CommunityBuyPayout?
  deliveryReferences        DeliveryReference[]
  fulfilmentEvents          CampaignFulfilmentEvent[]
  organiserFee              CommunityBuyOrganiserFee?
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt

  @@index([status, country])
  @@index([organiserId])
  @@index([supplierId])
  @@index([supplierAccountId])
  @@index([deadline])
  @@index([rescueEndsAt])
  @@index([paymentMode, status])
}

enum CampaignUpdateAuthorRole {
  ORGANISER
  SUPPLIER
  SYSTEM
}

/**
 * A real, campaign-wide broadcast update an organiser or supplier posts —
 * visible identically to every participant, unlike the per-user
 * Notification rows communityCampaignsService already writes for system
 * events (outcome, rescue window, refund progress), which stay exactly as
 * they are. Communication content only: no financial field on this model,
 * so there is nothing here that could ever change price/minimum/goal/
 * maximum — that stays exclusively on CommunityCampaign itself, editable
 * only through the existing campaign-edit path.
 */
model CampaignUpdate {
  id           String                   @id @default(cuid())
  campaignId   String
  authorUserId String?
  authorRole   CampaignUpdateAuthorRole
  title        String
  message      String
  campaign     CommunityCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt    DateTime                 @default(now())

  @@index([campaignId, createdAt])
}

enum FundingOutcome {
  PENDING
  GOAL_REACHED
  MINIMUM_REACHED
  BELOW_MINIMUM
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CampaignExtensionRequest {
  id                        String                 @id @default(cuid())
  campaignId                String
  requestedDeadline         DateTime
  reason                    String
  supplierReconfirmed       Boolean                @default(false)
  priceUnchangedConfirmed   Boolean                @default(false)
  participantTermsUnchanged Boolean                @default(false)
  status                    ExtensionRequestStatus @default(PENDING)
  reviewedById              String?
  reviewedAt                DateTime?
  reviewNotes               String?
  campaign                  CommunityCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([campaignId, status])
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Phase 4 (cancellation under review) — mirrors CampaignExtensionRequest's
// shape exactly (organiser requests something financially significant,
// admin approves/rejects). Not @unique on campaignId: a rejected request
// doesn't block a later, better-justified one on the same campaign — only
// application logic (one PENDING at a time) is enforced, same pattern as
// extension requests.
model CampaignCancellationRequest {
  id                     String                     @id @default(cuid())
  campaignId             String
  requestedByUserId      String
  reason                 String
  // Snapshotted at request time — true means at least one PAID
  // contribution existed, which is exactly what routed this request
  // through CANCELLATION_UNDER_REVIEW instead of an immediate cancel.
  hadFinancialActivity   Boolean
  // Snapshotted so rejection can restore the exact prior operational
  // state (spec requirement 7) — only meaningful when
  // hadFinancialActivity is true (the only case that actually leaves
  // CANCELLATION_UNDER_REVIEW to restore from).
  preCancellationStatus  CampaignStatus
  status                 CancellationRequestStatus  @default(PENDING)
  reviewedById           String?
  reviewedAt             DateTime?
  reviewNotes            String?
  campaign               CommunityCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([campaignId, status])
}

enum SupplierPaymentStatus {
  NOT_RELEASED
  PROCESSING
  PAID
  ON_HOLD
  FAILED
}

model CampaignSupplierPayment {
  id                              String                @id @default(cuid())
  campaignId                      String                @unique
  // Amount starts as the pledged estimate (confirmedShares × price) at
  // campaign-success time, then is kept in sync with the sum of actually
  // PAID contributions as charges resolve — see chargeAllPledgesForCampaign
  // in campaign-contributions.service.ts. releaseSupplierPayment() always
  // recomputes it live from PAID contributions before transferring, so a
  // stale value here can never cause an over/under transfer.
  amount                          Int
  currency                        String
  status                          SupplierPaymentStatus @default(NOT_RELEASED)
  payoutStripeAccountIdAtApproval String?
  // Diaspora escrow reconciliation (final V1 settlement doc §N) — snapshotted
  // once from CommunityCampaign.wholesaleAmountMinor at createSupplierOrder()
  // time. Null preserves the original behavior exactly: releaseSupplierPayment()
  // pays the supplier the full collected amount net of communityBuyFeeBps
  // (every campaign created before this field existed, or any supplier
  // campaign the organiser never gave a wholesale figure). When set,
  // releaseSupplierPayment() pays the supplier only THIS amount (net of the
  // same fee bps, now interpreted as the supplier's Eki commission rate),
  // and the remainder is released to the organiser separately via
  // CommunityBuyOrganiserPayout.
  wholesaleAmount                 Int?
  // Eki's processing fee taken out of `amount` at release time (client
  // mandate 2026-09: "Eki takes its configured processing fee"), and what
  // the supplier actually received after it — both snapshotted at release,
  // not estimated earlier, since the market's fee bps could change before
  // release. stripeTransferId is the real Stripe Connect transfer that
  // moved netAmount to the supplier's connected account.
  feeAmount                       Int?
  netAmount                       Int?
  stripeTransferId                String?
  holdReason                      String?
  releasedById                    String?
  releasedAt                      DateTime?
  campaign                        CommunityCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  @@index([status])
}

// Diaspora escrow reconciliation (final V1 settlement doc §N) — the
// organiser's net Community Buy proceeds. Created for EVERY successful
// campaign (self-supply, external-supplier-via-self, AND supplier-fulfilled
// alike) — unlike CampaignSupplierPayment, which only ever exists for
// fulfilmentOwner=SUPPLIER. Deliberately its own model, not a retrofit of
// CampaignSupplierPayment: a supplier payable and an organiser payable are
// two distinct recipients that can both exist for the same campaign, and
// giving each its own row keeps the admin release action, four-eyes gate and
// ledger legs for one from ever being confused with the other. Mirrors
// CampaignSupplierPayment's exact shape/lifecycle (same SupplierPaymentStatus
// enum, same recompute-live-at-release discipline) rather than inventing a
// new one.
model CommunityBuyOrganiserPayout {
  id                              String                @id @default(cuid())
  campaignId                      String                @unique
  organiserId                     String
  // Organiser's GROSS retail proceeds before Eki's commission: total
  // collected minus the wholesale amount already earmarked for an Eki
  // supplier (0 when a legacy supplier campaign has no wholesaleAmount —
  // then 100% already went to the supplier via the unmodified legacy path,
  // so there is genuinely nothing left for the organiser). Recomputed live
  // at release time from actual PAID contributions, same discipline as
  // CampaignSupplierPayment.amount.
  amount                          Int                   @default(0)
  currency                        String
  status                          SupplierPaymentStatus @default(NOT_RELEASED)
  payoutStripeAccountIdAtApproval String?
  commissionAmount                Int?
  netAmount                       Int?
  stripeTransferId                String?
  holdReason                      String?
  releasedById                    String?
  releasedAt                      DateTime?
  organiser                       OrganiserProfile      @relation(fields: [organiserId], references: [id], onDelete: Restrict)
  campaign                        CommunityCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  @@index([status])
  @@index([organiserId])
}

// Operational fulfilment tracking for the supplier, separate from
// CampaignSupplierPayment (financial only). Created once alongside it,
// the moment a campaign succeeds — see createSupplierOrder(). Progressing
// this state machine never moves money; supplier payment release/hold
// stays a distinct, admin-controlled action.
model CampaignFulfilment {
  id                   String            @id @default(cuid())
  campaignId           String            @unique
  status               FulfilmentStatus  @default(AWAITING_INVENTORY_CONFIRMATION)
  method               FulfilmentMethod?
  notes                String?
  estimatedReadyAt     DateTime?
  inventoryConfirmedAt DateTime?
  packingStartedAt     DateTime?
  readyAt              DateTime?
  dispatchedAt         DateTime?
  collectedAt          DateTime?
  campaign             CommunityCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status])
}

enum FulfilmentStatus {
  AWAITING_INVENTORY_CONFIRMATION
  INVENTORY_CONFIRMED
  PACKING
  READY_FOR_DISPATCH_OR_COLLECTION
  DISPATCHED
  COLLECTED
  COMPLETED
}

enum FulfilmentMethod {
  DELIVERY
  COLLECTION
}

// M5 (spec §10.2 step 5 "fulfilment evidence"; Appendix B event catalogue:
// order_ready, packed, handed_to_courier, collected, delivered,
// delivery_exception, evidence_submitted) — append-only historical record
// alongside CampaignFulfilment's mutable current-state row. Never updated
// or deleted after creation; a correction is a new event, not an edit.
// Written by campaign-fulfilment.service.ts's recordFulfilmentEvent()
// (never throws — mirrors community-buy-privacy.service.ts's
// recordDataAccess() contract) at every existing state transition, plus
// the new participant-facing receipt-confirmation/problem-report actions.
model CampaignFulfilmentEvent {
  id             String                   @id @default(cuid())
  campaignId     String
  contributionId String?
  actorUserId    String
  actorRole      FulfilmentEventActorRole
  eventType      FulfilmentEventType
  note           String?
  metadata       Json?
  campaign       CommunityCampaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())

  @@index([campaignId, createdAt])
  @@index([contributionId])
}

enum FulfilmentEventActorRole {
  SUPPLIER
  ORGANISER
  PARTICIPANT
  ADMIN
}

enum FulfilmentEventType {
  INVENTORY_CONFIRMED
  PLAN_SET
  PACKING_STARTED
  READY
  DISPATCHED
  COLLECTED
  COMPLETED
  EXCEPTION
  PARTICIPANT_RECEIPT_CONFIRMED
  PARTICIPANT_PROBLEM_REPORTED
}

model CampaignParticipant {
  id                            String                 @id @default(cuid())
  campaignId                    String
  userId                        String
  joinedAt                      DateTime               @default(now())
  // M7 (spec §14.5/§15.2) — organiser acquisition attribution. Computed
  // exactly once, server-side, inside join() — the spec names no organiser-
  // facing "edit attribution" action, only an admin investigation outcome
  // (see attributionStatus/attributionOverrideReason below), so there is no
  // post-join mutation path to guard against beyond that one admin action.
  // acquisitionOrganiserId stores CommunityCampaign.organiserId
  // (OrganiserProfile.id), matching that field's own identifier convention.
  acquisitionOrganiserId        String?
  acquisitionCampaignId         String?
  acquiredAt                    DateTime?
  organiserAttributionExpiresAt DateTime?
  attributionSource             AttributionSource?
  // Points at the ORIGINAL CampaignParticipant row a reorder's attribution
  // was retained from (spec AT-45) — null for a fresh/independent
  // acquisition. No FK: deliberately cross-campaign and read-only.
  repeatCampaignParentId        String?
  attributionStatus             AttributionStatus      @default(ACTIVE)
  attributionOverrideReason     String?
  campaign                      CommunityCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions                 CampaignContribution[]

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([acquisitionOrganiserId])
}

enum AttributionSource {
  DIRECT_JOIN
  REORDER_RETAINED
  SELF
}

// Never auto-set beyond ACTIVE — UNDER_REVIEW/INVALIDATED only ever result
// from an explicit admin investigation action (spec §14.5: "do not auto-
// divert rewards").
enum AttributionStatus {
  ACTIVE
  UNDER_REVIEW
  INVALIDATED
}

model CampaignContribution {
  id                    String                            @id @default(cuid())
  campaignId            String
  participantId         String
  amount                Int
  currency              String
  quantity              Int                               @default(1)
  // Diaspora escrow reconciliation (final V1 settlement doc §N) — Eki's 5%
  // buyer service fee (bounded £1.20-£5.00), charged ON TOP of `amount` at
  // the same off-session capture attemptCharge() already makes. Kept
  // separate from `amount` deliberately: `amount` stays product-subtotal-
  // only so capacity checks, campaign totals and supplier settlement math
  // (all keyed on quantity × pricePerShareMinor) are completely unaffected.
  // Defaults to 0 for every contribution created before this field existed.
  buyerServiceFeeAmount Int                               @default(0)
  isOrganiserTopUp      Boolean                           @default(false)
  status                ContributionStatus                @default(INITIATED)
  stripePaymentIntentId String?
  // Client mandate (2026-09): "Eki never takes the fund upfront... payment
  // go to the owner [only] at end of campaign" — PLEDGE_THEN_CHARGE model.
  // The participant's saved card (SetupIntent, collected via the existing
  // buyer/payment-methods flow — see BuyerPaymentMethod / payment-methods.
  // service.ts, originally built for Regular Deliveries) is attached at
  // pledge time; nothing is captured until the campaign succeeds and
  // chargeAllPledgesForCampaign() runs the actual off-session charge.
  paymentMethodId       String?
  // Phase 3 (address + privacy foundation) — the buyer's own delivery
  // address, entered at pledge time, required only when the campaign's
  // deliveryPreference is DELIVERY (assertDeliveryAddressWithinCoverage()
  // in campaign-contributions.service.ts). Null for every COLLECTION
  // pledge and every contribution created before this field existed.
  // Privacy-sensitive: never selected into the supplier-facing manifest
  // (community-buy-manifest.service.ts) — only the owning organiser can
  // read it, via listParticipantsForOrganiser(), and only for a PAID
  // contribution on a DELIVERY campaign.
  deliveryRecipientName String?
  deliveryAddressLine1  String?
  deliveryAddressLine2  String?
  deliveryCity          String?
  deliveryPostcode      String?
  campaign              CommunityCampaign                 @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  participant           CampaignParticipant               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  paymentMethod         BuyerPaymentMethod?               @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refund                CampaignRefund?
  chargeAttempts        CampaignChargeAttempt[]
  // M2 — 1:1 sibling, only ever set for AUTHORISE_THEN_CAPTURE-mode
  // campaigns (see CommunityCampaign.paymentMode). This contribution row
  // stays the durable commitment/consent record either way (amount,
  // currency, quantity unchanged); the sibling row owns only the
  // Stripe-hold-mechanics fields — see CommunityBuyPaymentAuthorisation's
  // own doc comment for why this isn't a duplicate table.
  paymentAuthorisation  CommunityBuyPaymentAuthorisation?
  // M4 — 1:1, created only once this contribution is actually captured
  // (either payment mode); see DeliveryReference's own doc comment.
  deliveryReference     DeliveryReference?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  @@index([campaignId, status])
  @@index([participantId])
  @@index([paymentMethodId])
}

// Idempotent off-session charge attempts for a pledged contribution, taken
// only once the campaign succeeds — mirrors SubscriptionPaymentAttempt
// (Regular Deliveries renewals.service.ts), the same pattern already
// proven for "charge a saved card while the buyer isn't present".
model CampaignChargeAttempt {
  id                    String                           @id @default(cuid())
  contributionId        String
  attemptNumber         Int
  status                SubscriptionPaymentAttemptStatus @default(PENDING)
  // Idempotency key sent to Stripe: "{contributionId}:{attemptNumber}".
  idempotencyKey        String                           @unique
  stripePaymentIntentId String?
  failureCode           String?
  failureMessage        String?
  contribution          CampaignContribution             @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@unique([contributionId, attemptNumber])
  @@index([contributionId])
}

// M4 (spec §15.7) — one row per CAPTURED contribution (created only once a
// contribution actually becomes PAID, in either payment mode — never
// before; see communityBuyPrivacyService.createDeliveryReferenceForContribution()).
// Deliberately has NO address/phone field at all: for a COLLECTION campaign
// nothing beyond a status is ever needed; for a DELIVERY campaign (currently
// unreachable in production — gated off by
// COMMUNITY_BUY_INDIVIDUAL_DELIVERY_ENABLED) courierProvider/
// externalDeliveryToken/labelReference stay null until a real courier/
// token-vault integration exists — see that env gate's own doc comment for
// why this repo deliberately does not invent one.
model DeliveryReference {
  id                    String                     @id @default(cuid())
  campaignId            String
  contributionId        String                     @unique
  participantId         String
  deliveryMethod        CampaignDeliveryPreference
  status                DeliveryReferenceStatus    @default(NOT_REQUIRED)
  // Coarse only (e.g. a postcode/area), never a full address — unused until
  // individual delivery is real; left null for every COLLECTION row.
  deliveryArea          String?
  labelReference        String?
  externalDeliveryToken String?
  courierProvider       String?
  expiresAt             DateTime?
  revokedAt             DateTime?
  revocationReason      String?
  campaign              CommunityCampaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  contribution          CampaignContribution       @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([campaignId, status])
  @@index([status, expiresAt])
}

enum DeliveryReferenceStatus {
  NOT_REQUIRED // collection-point order — terminal, nothing to track
  PENDING
  LABEL_GENERATED
  HANDED_TO_COURIER
  DELIVERED
  COLLECTED
  EXCEPTION
  REVOKED
}

model CampaignRefund {
  id                     String               @id @default(cuid())
  contributionId         String               @unique
  amount                 Int
  currency               String
  status                 ContributionStatus   @default(REFUND_PENDING)
  idempotencyKey         String               @unique
  stripeRefundId         String?
  failureReason          String?
  // CBA-06 fix: escalateRefund() previously had no way to tell it had
  // already run for this refund, so a reload + re-click created a
  // duplicate CommunityBuySupportCase every time. These mirror the
  // idempotency-marker pattern already used elsewhere in this codebase
  // (e.g. PayoutRequest.stripeTransferId) rather than inventing a new one.
  escalated              Boolean              @default(false)
  escalatedAt            DateTime?
  escalatedSupportCaseId String?
  contribution           CampaignContribution @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([status])
}

// ─── M2 — Payment hold/capture (AUTHORISE_THEN_CAPTURE mode) ──────────────
// Additive throughout: PLEDGE_THEN_CHARGE campaigns never create rows in
// either model below, and CampaignContribution/CampaignChargeAttempt/
// CampaignSupplierPayment are untouched by anything here.

enum CommunityBuyHoldStatus {
  NOT_REQUESTED // no Stripe object created yet
  HOLD_PENDING // manual-capture PaymentIntent created, awaiting outcome
  REQUIRES_ACTION
  HOLD_SUCCEEDED // funds authorised (Stripe status requires_capture)
  HOLD_DECLINED
  HOLD_EXPIRING // captureBefore is within the warning buffer, not yet captured/released
  HOLD_RELEASED // cancelled before charge (never call this "refunded" — spec §11.5)
}

enum CommunityBuyCaptureStatus {
  NOT_CAPTURED
  CAPTURE_PENDING
  CAPTURED
  CAPTURE_FAILED
  REFUNDED
  DISPUTED
}

// spec §15.3. 1:1 with CampaignContribution (contributionId unique) — see
// that field's own doc comment for why this doesn't duplicate amount/
// currency/quantity. supplierConnectedAccountId/paymentMethodReference are
// per-authorisation because Stripe Connect Direct Charges require the
// PaymentMethod to live in the SAME connected-account context as the
// charge (spec §11.1's "supplier is merchant of record") — this is
// deliberately NOT the shared BuyerPaymentMethod row (see
// campaign-authorisation.service.ts's doc comment for the full reasoning).
model CommunityBuyPaymentAuthorisation {
  id                         String                    @id @default(cuid())
  contributionId             String                    @unique
  campaignId                 String
  supplierConnectedAccountId String
  setupIntentId              String
  paymentMethodReference     String
  paymentIntentId            String?                   @unique
  consentedAt                DateTime
  consentWordingVersion      String
  consentedChargeAmount      Int
  consentCurrency            String
  // Null until HOLD_SUCCEEDED — spec 11.2: "Do not populate authorised_amount" before then.
  authorisedAmount           Int?
  holdStatus                 CommunityBuyHoldStatus    @default(NOT_REQUESTED)
  holdCreatedAt              DateTime?
  // The ACTUAL provider-reported expiry — never assumed at a fixed window
  // (spec 11.3 step 5). Reliability of this field is flagged as an
  // external-dependency item pending Stripe API verification (M2 plan §J).
  captureBefore              DateTime?
  holdExpiryWarningAt        DateTime?
  holdRecoveryDeadline       DateTime?
  authenticationStatus       String?
  captureStatus              CommunityBuyCaptureStatus @default(NOT_CAPTURED)
  providerErrorCode          String?
  retryCount                 Int                       @default(0)
  idempotencyKey             String                    @unique
  latestWebhookEventId       String?
  contribution               CampaignContribution      @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  campaign                   CommunityCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([campaignId])
  @@index([holdStatus])
  @@index([captureBefore])
}

enum CommunityBuyPayoutStatus {
  HELD
  READY
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  REVERSED
  CANCELLED
  MANUAL_REVIEW
}

// spec §15.5. Parallel to CampaignSupplierPayment (PLEDGE_THEN_CHARGE mode),
// never shared with it — see the M2 plan §H for why: under Direct Charges,
// the supplier's net share lands in THEIR connected account automatically
// at capture time (application_fee_amount split), so this model tracks the
// GOVERNANCE/reporting of that money, not a platform->supplier transfer the
// way CampaignSupplierPayment.releaseSupplierPayment() does. Whether
// `status` can ever mean genuine fund custody depends on an unresolved,
// explicitly-flagged external question (manual vs automatic Stripe Connect
// payout schedule) — see campaign-payout.service.ts's doc comment.
model CommunityBuyPayout {
  id                           String                   @id @default(cuid())
  campaignId                   String                   @unique
  supplierId                   String // SupplierAccount.id
  supplierConnectedAccountId   String
  currency                     String
  capturedGrossAmount          Int                      @default(0)
  providerFeeAmount            Int                      @default(0)
  supplierPayableAmount        Int                      @default(0)
  // Always 0 in M2 — CommunityBuyOrganiserFee is out of scope (WS8). Column
  // exists now so the ledger/reporting shape is forward-compatible.
  organiserFeeAmount           Int                      @default(0)
  ekiFeeAmount                 Int                      @default(0)
  refundDeductionAmount        Int                      @default(0)
  disputeDeductionAmount       Int                      @default(0)
  reserveAmount                Int                      @default(0)
  netPayoutAmount              Int                      @default(0)
  status                       CommunityBuyPayoutStatus @default(HELD)
  holdReasonCodes              String[]                 @default([])
  releaseCondition             String?
  releaseEligibleAt            DateTime?
  providerPayoutId             String?
  providerBalanceTransactionId String?
  requestedAt                  DateTime?
  submittedAt                  DateTime?
  inTransitAt                  DateTime?
  paidAt                       DateTime?
  failedAt                     DateTime?
  reversedAt                   DateTime?
  failureCode                  String?
  failureMessage               String?
  retryCount                   Int                      @default(0)
  idempotencyKey               String?                  @unique
  latestProviderEventId        String?
  campaign                     CommunityCampaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@index([status])
}

// M7 (spec §13.3/§15.6) — organiser reward for third-party-supply campaigns
// (fulfilmentOwner=SUPPLIER only — self-supply organisers already ARE the
// supplier, spec never describes a second reward for them). Accrued only
// from genuinely captured orders, never participant principal (invariant
// #10). Cash settlement is explicitly excluded from v1 (spec §1.3/§26)
// pending a confirmed settlement route — see organiser-fee.service.ts's own
// doc comment for the production gate. Never share a code path with
// CommunityBuyPayout: an organiser fee is never a supplier payout.
model CommunityBuyOrganiserFee {
  id                     String                         @id @default(cuid())
  campaignId             String                         @unique
  organiserId            String
  supplierId             String?
  currency               String
  // Snapshotted once from pricePerShareMinor × MarketConfiguration.
  // organiserFeeBps at the first capture — never recomputed if the market
  // rate changes mid-campaign (same immutable-snapshot principle as
  // CommunityCampaign.paymentMode).
  feePerCapturedOrder    Int
  capturedQuantity       Int                            @default(0)
  grossFeeAmount         Int                            @default(0)
  refundDeductionAmount  Int                            @default(0)
  disputeDeductionAmount Int                            @default(0)
  netFeeAmount           Int                            @default(0)
  status                 CommunityBuyOrganiserFeeStatus @default(ACCRUED)
  settlementMethod       OrganiserFeeSettlementMethod   @default(NONE)
  providerReference      String?
  releaseCondition       String?
  heldReasonCodes        String[]                       @default([])
  settledAt              DateTime?
  failureCode            String?
  idempotencyKey         String?                        @unique
  campaign               CommunityCampaign              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([status])
  @@index([organiserId])
}

enum CommunityBuyOrganiserFeeStatus {
  ACCRUED
  HELD
  BLOCKED_NO_SETTLEMENT_ROUTE
  SETTLED
  CANCELLED
  REVERSED
}

// NONE is the only reachable default in this environment. The two non-cash
// routes (spec §1.3: "a supplier-paid external commercial arrangement, or a
// non-cash reward") need no Stripe involvement and are safe to record today.
// STRIPE_CONNECT_TRANSFER represents the eventual real-cash route named in
// spec §26 as an unresolved external dependency — gated, see
// organiser-fee.service.ts.
enum OrganiserFeeSettlementMethod {
  NONE
  EXTERNAL_SUPPLIER_ARRANGEMENT
  NON_CASH_REWARD
  STRIPE_CONNECT_TRANSFER
}

// M7 — append-only, one row per captured contribution ever accrued into a
// CommunityBuyOrganiserFee. Enforces "never accrue the same capture twice"
// (master prompt invariant) as a real DB unique constraint rather than
// relying solely on caller discipline — same create-and-catch-P2002
// idempotency pattern already used for WebhookEvent.
model OrganiserFeeAccrualEvent {
  id             String   @id @default(cuid())
  campaignId     String
  contributionId String   @unique
  quantity       Int
  amount         Int
  createdAt      DateTime @default(now())

  @@index([campaignId])
}

// M4 (spec §15.8) — append-only access/action trail for anything a
// supplier, organiser or admin does against a participant's delivery/
// contact data. Deliberately loosely-coupled (plain string IDs, no hard FK
// relations to campaign/contribution/participant) rather than
// relationally joined, mirroring LedgerEntry's own "immutable event record"
// shape — this table must never block or be blocked by a campaign/
// contribution being deleted or restructured. Never updated after creation
// except to set revokedAt/revocationReason on the ONE row a later
// revocation targets.
model CommunityBuyDataAccessLog {
  id                String             @id @default(cuid())
  campaignId        String
  contributionId    String?
  participantId     String?
  accessorAccountId String?
  accessorUserId    String
  accessorRole      DataAccessorRole
  dataCategory      DataAccessCategory
  action            DataAccessAction
  purposeCode       String
  accessedAt        DateTime           @default(now())
  accessExpiresAt   DateTime?
  // Privacy-preserving equivalent of IP address (spec §15.8's own wording)
  // — a hash, never the raw address.
  ipAddressHash     String?
  deviceOrSessionId String?
  controlScope      String?
  adminOverrideId   String?
  revokedAt         DateTime?
  revocationReason  String?
  createdAt         DateTime           @default(now())

  @@index([campaignId, accessedAt])
  @@index([accessorUserId, accessedAt])
  @@index([action])
  @@index([accessExpiresAt])
}

enum DataAccessorRole {
  SUPPLIER
  ORGANISER
  ADMIN
}

enum DataAccessCategory {
  DELIVERY_STATUS
  CONTACT_CHANNEL
  EMERGENCY_NUMBER
  MANIFEST
  // Phase 3 (address + privacy foundation) — a buyer's own structured
  // delivery address (line1/2, city, postcode, recipient name), distinct
  // from DELIVERY_STATUS (dispatch/collected progress, no address content).
  // Only ever logged for the owning organiser's own read
  // (listParticipantsForOrganiser) — never for a supplier; see
  // community-buy-manifest.service.ts's own "no raw home addresses"
  // doc comment, which this category is never used against.
  ADDRESS_DETAIL
}

enum DataAccessAction {
  VIEWED
  LABEL_GENERATED
  MESSAGE_SENT
  PROXY_CALL_STARTED
  COURIER_SHARED
  ACCESS_REVOKED
  ADMIN_OVERRIDE
}

// Per-country configuration gate. Every market defaults to Community Buy
// fully disabled — see scope note above.
model MarketConfiguration {
  id                           String  @id @default(cuid())
  countryCode                  String  @unique
  currency                     String
  communityBuyEnabled          Boolean @default(false)
  communityBuyPaymentsEnabled  Boolean @default(false)
  organiserApplicationsEnabled Boolean @default(false)
  supplierApplicationsEnabled  Boolean @default(false)
  regularDeliveriesEnabled     Boolean @default(false)

  // Architecture doc §8 (Market Controls) — added in the A→Z gap-closure pass.
  // paymentProvider/identityProvider are read by feature evaluation to reject
  // an operation the country has no working rail/verifier for (e.g. no pooled
  // Community Buy payment in a market with paymentMode=DISABLED).
  paymentMode               MarketPaymentMode     @default(DISABLED)
  paymentProvider           String? // "stripe" | "paystack" | null (no provider configured yet)
  identityProvider          String? // "stripe_identity" | null
  acceptedIdentityDocuments String[]              @default([])
  campaignMinDurationHours  Int?
  campaignMaxDurationHours  Int?
  campaignMinValueAmount    Int?
  campaignMaxValueAmount    Int?
  refundTermsVersion        String?
  organiserFeeBps           Int?
  supplierReleasePolicy     SupplierReleasePolicy @default(ON_DELIVERY_CONFIRMED)
  deliveryMethods           String[]              @default([])
  legalTermsVersion         String?

  // Client mandate (2026-09): "Eki does not hold customer funds... payment
  // mode must be country-configurable... if a market has no explicit
  // approved payment mode, disable Community Buy payment there."
  // PLEDGE_THEN_CHARGE (campaign-contributions.service.ts) is the original
  // implemented mode. M2 adds a second, real, implemented mode —
  // AUTHORISE_THEN_CAPTURE (campaign-authorisation.service.ts, spec §11) —
  // this is the per-market feature flag that selects it; a campaign
  // snapshots whichever mode is configured here at creation time onto
  // CommunityCampaign.paymentMode and never re-reads this field afterward
  // (see that field's own doc comment). Every market defaults to null/
  // PLEDGE_THEN_CHARGE today — flipping a market to AUTHORISE_THEN_CAPTURE
  // in production is gated on the external confirmations named in the M2
  // plan (Stripe Connect Direct Charges country/capability approval,
  // connected-account payout-schedule configuration, capture_before
  // reliability) and is not done anywhere by this change. PAY_NOW_
  // REFUND_ON_FAILURE remains unimplemented — a market set to it is still
  // treated as unsupported, same as null.
  communityBuyPaymentMode CommunityBuyPaymentMode?

  // Diaspora final V1 settlement doc §N item 4 — "supplier-side Eki platform
  // commission": 8% of the agreed wholesale settlement, taken at
  // releaseSupplierPayment() time. Originally "Community Buy processing fee"
  // taken from the FULL collected total (client mandate 2026-09); now
  // confirmed as the client's final V1 number and given a real default so
  // it's never an unresolved decision. When a campaign has no
  // wholesaleAmountMinor (self-supply, external supplier, or a pre-existing
  // campaign), this still applies to the full collected total exactly as it
  // always did — see CampaignSupplierPayment.wholesaleAmount's own comment.
  communityBuyFeeBps Int @default(800)

  // Diaspora final V1 settlement doc §N item 3 — "organiser-owned campaign
  // and Eki platform commission": 10% of the campaign's retail PRODUCT
  // subtotal only (excludes delivery, the buyer service fee, refunds and
  // chargebacks), taken when releasing the organiser's net proceeds. Never
  // confuse with organiserFeeBps above (M7's pre-existing, unrelated
  // organiser-reward-FROM-Eki accrual, paid in the opposite direction).
  organiserCommissionBps   Int @default(1000)
  // Diaspora final V1 settlement doc §N item 2 — Eki's buyer-side service
  // fee: 5% of the buyer's Community Buy product subtotal, bounded to
  // between buyerServiceFeeMinAmount and buyerServiceFeeMaxAmount (minor
  // units), excluding delivery/collection. Charged on top of the product
  // amount at the same capture attemptCharge() already makes.
  buyerServiceFeeBps       Int @default(500)
  buyerServiceFeeMinAmount Int @default(120)
  buyerServiceFeeMaxAmount Int @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarketPaymentMode {
  DISABLED
  TEST
  LIVE
}

enum CommunityBuyPaymentMode {
  PAY_NOW_REFUND_ON_FAILURE
  AUTHORISE_THEN_CAPTURE
  PLEDGE_THEN_CHARGE
}

enum SupplierReleasePolicy {
  ON_DELIVERY_CONFIRMED
  ON_FULFILMENT_MARKED
  MANUAL_ADMIN_RELEASE
}

// ─── Internal Ledger (architecture doc §3) ────────────────────────────────
// Double-entry bookkeeping layer, additive to the existing Payment/Order/
// Wallet records — it does not replace them or change their behavior.
// Entries are append-only: a correction is a reversing entry, never an
// update or delete. The chart-of-accounts mapping below (which event posts
// to which account) is the ENGINEERING DEFAULT and is explicitly flagged in
// docs as requiring business/finance sign-off — see docs/decisions/0006-ledger-chart-of-accounts.md.
model LedgerAccount {
  id        String            @id @default(cuid())
  type      LedgerAccountType
  currency  String
  ownerType LedgerOwnerType
  ownerId   String? // vendorId / buyerId / supplierId — null for platform-owned accounts
  entries   LedgerEntry[]
  createdAt DateTime          @default(now())

  @@unique([type, currency, ownerType, ownerId])
  @@index([ownerType, ownerId])
}

enum LedgerAccountType {
  PROVIDER_CASH
  PLATFORM_FEE_REVENUE
  VENDOR_PAYABLE
  SUPPLIER_PAYABLE
  BUYER_WALLET_LIABILITY
  REFUND_CLEARING
  COMMUNITY_BUY_ESCROW
  // M2 — informational-only account tracking funds sitting in a supplier's
  // OWN Stripe Connect balance after a Direct Charge capture (never Eki's
  // cash) — see campaign-authorisation.service.ts's ledger-posting doc
  // comment for why this exists instead of crediting SUPPLIER_PAYABLE
  // against COMMUNITY_BUY_ESCROW the way the old payout path does.
  SUPPLIER_CONNECTED_BALANCE
  // Diaspora escrow reconciliation — the organiser's net Community Buy
  // proceeds, released from COMMUNITY_BUY_ESCROW via
  // CommunityBuyOrganiserPayout, mirroring SUPPLIER_PAYABLE/VENDOR_PAYABLE.
  ORGANISER_PAYABLE
}

enum LedgerOwnerType {
  PLATFORM
  VENDOR
  BUYER
  SUPPLIER
  ORGANISER
}

model LedgerEntry {
  id              String          @id @default(cuid())
  accountId       String
  account         LedgerAccount   @relation(fields: [accountId], references: [id])
  direction       LedgerDirection
  amount          Int // minor units, always positive; direction carries the sign
  currency        String
  businessRefType String // "Payment" | "Refund" | "Payout" | "Transfer" | "CampaignRefund" | ...
  businessRefId   String
  providerRef     String? // Stripe/Paystack charge, refund, or transfer id
  description     String
  reversesEntryId String? // set when this entry reverses a prior one (correction, never edited/deleted)
  postedAt        DateTime        @default(now())

  @@index([accountId, postedAt])
  @@index([businessRefType, businessRefId])
  @@index([providerRef])
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model ReconciliationRun {
  id           String                     @id @default(cuid())
  provider     String // "stripe" | "paystack"
  periodStart  DateTime
  periodEnd    DateTime
  status       ReconciliationRunStatus    @default(RUNNING)
  differences  ReconciliationDifference[]
  totalChecked Int                        @default(0)
  startedAt    DateTime                   @default(now())
  completedAt  DateTime?

  @@index([provider, startedAt])
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ReconciliationDifference {
  id              String                         @id @default(cuid())
  runId           String
  run             ReconciliationRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  businessRefType String
  businessRefId   String
  providerRef     String?
  expectedAmount  Int?
  actualAmount    Int?
  kind            String // "MISSING_LOCALLY" | "MISSING_AT_PROVIDER" | "AMOUNT_MISMATCH" | "STATUS_MISMATCH"
  status          ReconciliationDifferenceStatus @default(OPEN)
  note            String?
  createdAt       DateTime                       @default(now())
  resolvedAt      DateTime?

  @@index([runId, status])
}

enum ReconciliationDifferenceStatus {
  OPEN
  RESOLVED
}

// ─── Admin four-eyes approval (architecture doc §7) ───────────────────────
// Generic second-admin-approval record for any high-risk admin action.
// The monetary/severity threshold that decides whether an action REQUIRES
// this is configurable — see AdminApprovalRule — never hardcoded.
model AdminApprovalRule {
  id              String   @id @default(cuid())
  actionType      String   @unique // e.g. "refund.large", "payout.large", "role.grant_super_admin"
  thresholdAmount Int? // minor units; null = always requires approval regardless of amount
  currency        String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminApproval {
  id              String              @id @default(cuid())
  actionType      String
  businessRefType String
  businessRefId   String
  amount          Int?
  currency        String?
  requestedById   String
  requestedBy     User                @relation("AdminApprovalRequestedBy", fields: [requestedById], references: [id])
  reason          String
  status          AdminApprovalStatus @default(PENDING)
  decidedById     String?
  decidedBy       User?               @relation("AdminApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime            @default(now())

  @@index([status, actionType])
  @@index([businessRefType, businessRefId])
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
