generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
  PAYMENT_SECURED
  VENDOR_CONFIRMED
  DISPUTED
  AUTO_RELEASED
}

enum EscrowType {
  NONE
  DOMESTIC_AFRICA
}

enum EscrowOtpChannel {
  SMS
  EMAIL
  SMS_EMAIL
}

enum UploadAssetStatus {
  REQUESTED
  COMPLETED
  FAILED
}

enum PaystackTxStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WalletTransactionType {
  PENDING_TO_AVAILABLE
  PAYMENT_PENDING_CREDIT
  PAYOUT_DEBIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutMethodType {
  BANK_TRANSFER
  MOBILE_MONEY
  WISE
  PAYONEER
  OTHER
}

enum NotificationType {
  ORDER_PAID
  BALANCE_CREDITED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
  ADMIN_BROADCAST
  // Diaspora Expansion — Regular Deliveries. Sub-event is carried in
  // Notification.data.event (e.g. "renewal_upcoming", "payment_failed"),
  // matching the existing order_status sub-typing convention rather than
  // adding a new enum value per event.
  SUBSCRIPTION_UPDATE
  // Diaspora Expansion — Automation Engine. Sub-type is carried in
  // Notification.data.automationType.
  AUTOMATION_MESSAGE
  // Diaspora Expansion — Community Buy. Sub-event is carried in
  // Notification.data.event (e.g. "milestone_reached", "refund_started").
  COMMUNITY_CAMPAIGN_UPDATE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  name                    String
  // Nullable: an OAuth-only account (Google/Apple) has no Eki password.
  // authService.login() (email/password) explicitly rejects null rather
  // than letting bcrypt.compare receive it.
  password                String?
  phone                   String?               @unique
  avatar                  String?
  country                 String?
  referralCode            String?               @unique
  referredBy              String?
  tokenVersion            Int                   @default(0)
  failedLoginAttempts     Int                   @default(0)
  lockedUntil             DateTime?
  isSuspended             Boolean               @default(false)
  suspendedReason         String?
  emailVerifiedAt         DateTime?
  trustScore              Int                   @default(50)
  smsMarketingConsentAt   DateTime?
  smsTransactionalEnabled Boolean               @default(true)
  // Diaspora Expansion: consent for automated marketing messages (push +
  // email) sent by the Automation Engine — e.g. cart recovery, win-back,
  // review requests. Distinct from smsMarketingConsentAt (SMS-only) and
  // never gates transactional messages (order/payment status).
  marketingConsentAt      DateTime?
  role                    UserRole              @default(BUYER)
  vendor                  Vendor?
  orders                  Order[]               @relation("BuyerOrders")
  cart                    Cart?
  notifications           Notification[]
  purchasedGiftCards      PurchasedGiftCard[]
  adminTwoFactor          AdminTwoFactor?
  adminRoleAssignments    AdminRoleAssignment[]
  approvalsRequested      AdminApproval[]       @relation("AdminApprovalRequestedBy")
  approvalsDecided        AdminApproval[]       @relation("AdminApprovalDecidedBy")
  organiserProfile        OrganiserProfile?
  buyerSubscriptions      BuyerSubscription[]
  buyerPaymentMethods     BuyerPaymentMethod[]
  automationRuns          AutomationRun[]
  campaignParticipations  CampaignParticipant[]
  communityBuySupportCases CommunityBuySupportCase[]
  oauthIdentities         OAuthIdentity[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([role, createdAt])
  @@index([createdAt])
  @@index([isSuspended])
}

// Google/Apple Sign-In (see docs/decisions/0008-oauth-sign-in.md). One row
// per linked provider identity — a user can link both Google and Apple to
// the same Eki account. providerUserId is the provider's stable, opaque
// subject identifier (Google's `sub` / Apple's `sub`), never the email —
// Apple's email can be a private-relay address that isn't a real identity.
model OAuthIdentity {
  id             String       @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Email as reported by the provider at link time — informational only,
  // never re-derived as the identity key. Nullable for Apple private relay.
  email          String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@unique([provider, userId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model Vendor {
  id                          String                    @id @default(cuid())
  userId                      String                    @unique
  storeName                   String                    @unique
  storeSlug                   String                    @unique
  description                 String?
  contactEmail                String?
  contactPhone                String?
  country                     String?
  city                        String?
  businessType                String?
  sellerRegion                String?
  currency                    String                    @default("EUR")
  avatar                      String?
  coverImage                  String?
  isSuspended                 Boolean                   @default(false)
  suspendedReason             String?
  stripeAccountId             String?                   @unique
  stripeAccountStatus         String?
  stripePayoutsEnabled        Boolean                   @default(false)
  stripeChargesEnabled        Boolean                   @default(false)
  stripeOnboardedAt           DateTime?
  verificationStatus          VendorVerificationStatus  @default(PENDING)
  stripeVerificationSessionId String?
  verifiedAt                  DateTime?
  verificationFailureReason   String?
  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                      Wallet?
  products                    Product[]
  orderItems                  OrderItem[]
  walletTransactions          WalletTransaction[]
  payoutMethods               PayoutMethod[]
  payoutRequests              PayoutRequest[]
  bankAccounts                VendorBankAccount[]
  promoCodes                  PromoCode[]
  supplierProfile             SupplierProfile?
  subscriptionOffers          SubscriptionOffer[]
  automationSettings          VendorAutomationSetting[]
  automationRuns              AutomationRun[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([verificationStatus, createdAt])
  @@index([createdAt])
  @@index([isSuspended])
}

model PayoutMethod {
  id             String           @id @default(cuid())
  vendorId       String
  type           PayoutMethodType
  label          String?
  details        Json
  isDefault      Boolean          @default(false)
  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutRequests PayoutRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([vendorId])
}

model PayoutRequest {
  id                  String              @id @default(cuid())
  vendorId            String
  payoutMethodId      String
  amount              Int
  withdrawalFeeAmount Int                 @default(0)
  withdrawalFeeBps    Int                 @default(0)
  netAmount           Int?
  currency            String              @default("EUR")
  status              PayoutRequestStatus @default(PENDING)
  notes               String?
  rejectionReason     String?
  approvedById        String?
  approvedAt          DateTime?
  paidById            String?
  paidAt              DateTime?
  vendor              Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payoutMethod        PayoutMethod        @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  walletTransactions  WalletTransaction[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([vendorId, status])
  @@index([status, createdAt])
}

model Product {
  id                        String                     @id @default(cuid())
  productCode               String?                    @unique
  vendorId                  String
  title                     String
  description               String?
  priceInCents              Int
  costAmount                Int?
  costCurrency              String?
  currency                  String                     @default("EUR")
  images                    String[]                   @default([])
  category                  String?
  stock                     Int                        @default(0)
  weightGrams               Int?
  isActive                  Boolean                    @default(true)
  vendor                    Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderItems                OrderItem[]
  cartItems                 CartItem[]
  subscriptionOfferProducts SubscriptionOfferProduct[]
  subscriptionItems         SubscriptionItem[]
  renewalItems              RenewalItem[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([vendorId, title])
  @@index([productCode])
  @@index([vendorId, isActive])
  @@index([isActive, category])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String     @unique
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique @default(cuid())
  checkoutId          String?
  buyerId             String
  vendorId            String?
  status              OrderStatus          @default(PENDING)
  escrowType          EscrowType           @default(NONE)
  escrowExpiresAt     DateTime?
  vendorConfirmedAt   DateTime?
  disputedAt          DateTime?
  autoReleasedAt      DateTime?
  subtotalAmount      Int                  @default(0)
  deliveryFeeAmount   Int                  @default(0)
  platformFeeAmount   Int                  @default(0)
  vendorEarnings      Int                  @default(0)
  sellerPlanId        String?
  sellerPlanSlug      String?
  commissionTierId    String?
  commissionBps       Int?
  withdrawalFeeBps    Int?
  totalAmount         Int
  currency            String               @default("EUR")
  deliveryZoneId      String?
  deliveryAddress     String?
  notes               String?
  deliveredAt         DateTime?
  checkout            Checkout?            @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  buyer               User                 @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  deliveryZone        DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  sellerPlan          SellerPlan?          @relation(fields: [sellerPlanId], references: [id], onDelete: SetNull)
  commissionTier      CommissionTier?      @relation(fields: [commissionTierId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?
  paystackTransaction PaystackTransaction?
  deliveryOtp         DeliveryOtp?
  dispute             Dispute?
  walletTransactions  WalletTransaction[]
  renewal             Renewal?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([checkoutId])
  @@index([buyerId, status])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@index([escrowType, status])
  @@index([sellerPlanId])
  @@index([commissionTierId])
  @@index([createdAt])
}

model Checkout {
  id                    String        @id @default(cuid())
  buyerId               String
  stripePaymentIntentId String?       @unique
  totalAmount           Int
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  processedAt           DateTime?
  orders                Order[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  vendorId     String
  quantity     Int
  unitAmount   Int
  totalAmount  Int
  costAmount   Int?
  costCurrency String?
  currency     String   @default("EUR")
  productTitle String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId])
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String              @unique
  stripePaymentIntentId String?             @unique
  amount                Int
  platformFeeAmount     Int
  vendorEarningsAmount  Int
  sellerPlanId          String?
  sellerPlanSlug        String?
  commissionTierId      String?
  commissionBps         Int?
  withdrawalFeeBps      Int?
  currency              String              @default("EUR")
  status                PaymentStatus       @default(PENDING)
  provider              String              @default("stripe")
  metadata              Json?
  processedAt           DateTime?
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerPlan            SellerPlan?         @relation(fields: [sellerPlanId], references: [id], onDelete: SetNull)
  commissionTier        CommissionTier?     @relation(fields: [commissionTierId], references: [id], onDelete: SetNull)
  walletTransactions    WalletTransaction[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([sellerPlanId])
  @@index([commissionTierId])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Wallet {
  id               String              @id @default(cuid())
  vendorId         String              @unique
  pendingBalance   Int                 @default(0)
  availableBalance Int                 @default(0)
  currency         String              @default("EUR")
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  transactions     WalletTransaction[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletId        String
  vendorId        String
  orderId         String?
  paymentId       String?
  payoutRequestId String?
  type            WalletTransactionType
  amount          Int
  currency        String                @default("EUR")
  description     String?
  wallet          Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payoutRequest   PayoutRequest?        @relation(fields: [payoutRequestId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@unique([vendorId, orderId, paymentId, type])
  @@unique([payoutRequestId, type])
  @@index([walletId, createdAt])
  @@index([vendorId, createdAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([payoutRequestId])
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(cuid())
  buyerId     String
  vendorId    String
  productId   String?
  orderId     String
  rating      Int // 1-5
  comment     String?
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([buyerId, orderId, productId])
  @@index([vendorId, status])
  @@index([productId, status])
  @@index([buyerId])
  @@index([status, createdAt])
}

model DeliveryZone {
  id              String           @id @default(cuid())
  name            String
  country         String
  flag            String?
  baseFeeAmount   Int
  feePerKgAmount  Int
  currency        String           @default("EUR")
  isActive        Boolean          @default(true)
  vendorId        String?
  orders          Order[]
  deliveryMethods DeliveryMethod[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([country, isActive])
  @@index([vendorId, isActive])
}

model DeliveryMethod {
  id             String       @id @default(cuid())
  deliveryZoneId String
  label          String
  priceAmount    Int
  minDays        Int
  maxDays        Int
  isActive       Boolean      @default(true)
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([deliveryZoneId, isActive])
}

// ─── Phase 3: Shipment Tracking ─────────────────────────────────────────────

enum ShipmentStatus {
  PROCESSING
  IN_TRANSIT
  DELIVERED
  DELAYED
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  vendorId            String
  trackingNumber      String?
  carrier             String?
  status              ShipmentStatus @default(PROCESSING)
  estimatedDeliveryAt DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([vendorId, status])
  @@index([status])
  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

model WebhookEvent {
  id            String             @id @default(cuid())
  stripeEventId String             @unique
  eventType     String
  provider      String             @default("stripe")
  status        WebhookEventStatus @default(PROCESSING)
  paymentId     String?
  orderId       String?
  createdAt     DateTime           @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([eventType])
  @@index([paymentId])
  @@index([orderId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Email OTP Verification ─────────────────────────────────────────────────

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("vendor_onboarding_email")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

// ─── Phase 2: Messaging ──────────────────────────────────────────────────────

enum ConversationType {
  BUYER_VENDOR
  ADMIN_VENDOR
  DISPUTE
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(BUYER_VENDOR)
  participantA  String
  participantB  String
  orderId       String?
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([participantA, participantB, orderId])
  @@index([participantA, lastMessageAt])
  @@index([participantB, lastMessageAt])
  @@index([orderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  attachments    String[]     @default([])
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Phase 2: Verification Documents ────────────────────────────────────────

enum VerificationDocType {
  GOVERNMENT_ID
  BUSINESS_REGISTRATION
  SELFIE
}

enum VerificationDocStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id              String                @id @default(cuid())
  vendorId        String
  type            VerificationDocType
  idType          String?
  frontUrl        String
  backUrl         String?
  status          VerificationDocStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  deleteAfterAt   DateTime?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([vendorId, type])
  @@index([status])
  @@index([deleteAfterAt, deletedAt])
  @@index([status, createdAt])
}

// ─── Phase 2: Buyer Addresses ───────────────────────────────────────────────

model BuyerAddress {
  id            String              @id @default(cuid())
  buyerId       String
  recipientName String
  line1         String
  line2         String?
  city          String
  postalCode    String
  country       String
  phone         String?
  isDefault     Boolean             @default(false)
  subscriptions BuyerSubscription[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([buyerId])
}

// ─── Phase 4: Audit Log ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─── Phase 5: Buyer Wallet ──────────────────────────────────────────────────

enum BuyerWalletTxType {
  TOP_UP
  REFERRAL_BONUS
  ORDER_DEBIT
  REFUND_CREDIT
  WITHDRAWAL
}

model BuyerWallet {
  id           String                   @id @default(cuid())
  buyerId      String                   @unique
  balance      Int                      @default(0)
  currency     String                   @default("EUR")
  transactions BuyerWalletTransaction[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model BuyerWalletTransaction {
  id              String            @id @default(cuid())
  walletId        String
  buyerId         String
  type            BuyerWalletTxType
  amount          Int
  currency        String            @default("EUR")
  description     String?
  orderId         String?
  paymentIntentId String?
  wallet          BuyerWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@unique([paymentIntentId, type])
  @@index([walletId, createdAt])
  @@index([buyerId, createdAt])
}

// ─── Phase 5: Promo Codes ───────────────────────────────────────────────────

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id             String            @id @default(cuid())
  vendorId       String
  code           String
  type           PromoType
  value          Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int               @default(0)
  validFrom      DateTime          @default(now())
  validUntil     DateTime?
  isActive       Boolean           @default(true)
  vendor         Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  redemptions    PromoRedemption[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId, isActive])
  @@index([code, isActive])
  @@index([isActive, validFrom, validUntil])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  buyerId        String
  orderId        String?
  discountAmount Int
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())

  @@unique([promoCodeId, buyerId])
  @@index([buyerId])
}

// ─── Phase 5: Referrals ─────────────────────────────────────────────────────

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String    @unique
  bonusAmount Int
  currency    String    @default("EUR")
  creditedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId])
}

// ─── Phase 5: Rewards & Gifts ────────────────────────────────────────────────

enum RewardType {
  DISCOUNT_COUPON
  WALLET_BONUS
  FREE_SHIPPING
}

model Reward {
  id             String     @id @default(cuid())
  name           String
  description    String?
  type           RewardType
  value          Int
  currency       String     @default("GBP")
  minOrderAmount Int?
  isActive       Boolean    @default(true)
  maxClaims      Int?
  claimedCount   Int        @default(0)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
