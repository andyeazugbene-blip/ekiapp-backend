  sellerPlan       SellerPlan @relation(fields: [sellerPlanId], references: [id], onDelete: Cascade)
  orders           Order[]
  payments         Payment[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

