NODE_ENV=development
PORT=4000
# Comma-separated allowed origins for CORS. Leave empty to allow all (dev mode).
# Example: https://yourapp.com,https://admin.yourapp.com
CORS_ORIGINS=
# Local development: any standard Postgres URL works.
# Production on Vercel (serverless): use a Neon POOLED connection string
# (host contains `-pooler`, e.g.
#   postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# ). Pooled URLs are required because each warm Lambda holds its own
# Prisma client; the connection pool prevents exhausting Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_payments?schema=public"
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Separate signing secret for Stripe Identity's own webhook endpoint
# (vendor verification sessions) — Stripe issues this when you add a second
# webhook endpoint subscribed to identity.verification_session.* events.
# Falls back to an empty string (identity webhooks fail signature checks)
# if unset — required before Stripe Identity verification works in production.
STRIPE_IDENTITY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=usd
PLATFORM_FEE_BPS=1000
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
# Optional: enable Sentry error monitoring by setting your project DSN.
# Leave empty in local dev to disable.
SENTRY_DSN=
# Optional: enable BullMQ queues (notifications, emails, payouts) by
# pointing at a Redis instance. Leave empty in local dev to disable
# queueing; the app still runs without Redis.
REDIS_URL=
# Resend API key for transactional emails. Leave empty in local dev
# to log emails instead of sending them.
RESEND_API_KEY=
# From address for outgoing emails.
EMAIL_FROM=Culinary Tales <noreply@culinarytales.app>
# Frontend URL for links in emails (password reset, etc.)
FRONTEND_URL=http://localhost:3000
# Alternate name for FRONTEND_URL, used only if FRONTEND_URL is unset — kept
# for backward compatibility with older deployment configs. Set FRONTEND_URL
# instead unless you specifically need this fallback.
# PUBLIC_WEB_URL=http://localhost:3000
# Required in production: shared secret for the internal cron job routes
# (/api/internal/jobs/*). Vercel Cron (see vercel.json's "crons") sends this
# automatically as "Authorization: Bearer $CRON_SECRET" once you set the
# same value here as a Vercel project environment variable. Without it, the
# routes return 503 and never run.
CRON_SECRET=
# Public base URL for vendor storefront share links (no trailing slash).
# Vendor share URLs are formatted: {PUBLIC_STORE_BASE_URL}/store/{slug}
PUBLIC_STORE_BASE_URL=https://culinarytales.app
# Comma-separated. If unset in production the backend falls back to:
#   https://culinarytales.app,https://www.culinarytales.app,https://ekiapp-backend.vercel.app
# CORS_ORIGINS=https://culinarytales.app,https://www.culinarytales.app
# Base URL for uploaded files (S3/R2 bucket public URL).
UPLOAD_BASE_URL=/uploads

# ─── S3/Cloudflare R2 Storage ────────────────────────────────────────────────
# Required for production file uploads. Leave empty for dev (mock URLs).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://your-cdn.example.com

# ─── Admin Bootstrap ─────────────────────────────────────────────────────────
# Set these to auto-create the first admin on startup. Remove after first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─── Dev/QA Database Reset ───────────────────────────────────────────────────
# Required (12+ chars) to call POST /api/admin/reset-users, the dev/QA-only
# database wipe+reseed utility. That route 404s outside non-production
# environments regardless of this being set — see admin.routes.ts.
QA_RESET_PASSWORD=

# ─── Paystack (Domestic Africa Escrow) ───────────────────────────────────────
# Required for Nigeria/Ghana domestic escrow payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Escrow timing (hours)
ESCROW_AUTO_RELEASE_HOURS=24
ESCROW_VENDOR_TIMEOUT_HOURS=48

# ─── SMS (Vendor Notifications Fallback) ─────────────────────────────────────
SMS_PROVIDER=africastalking
SMS_API_KEY=
AT_USERNAME=sandbox
SMS_SENDER_ID=Eki
# ─── Operations Alert ────────────────────────────────────────────────────────
OPS_ALERT_EMAIL=

# ─── Cloudflare Turnstile (Bot Protection) ───────────────────────────────────
# Required in production for registration captcha. Leave empty in dev.
TURNSTILE_SECRET_KEY=
# Set to "true" to explicitly disable Turnstile in production (not recommended)
TURNSTILE_DISABLED=

# ─── CLIENT CONFIGURATION REQUIRED — no approved default exists ─────────────
# These three are deliberately unset by default: no business-approved value
# has been provided for any of them, and the code that reads them treats
# "unset" as a safe, explicit no-op rather than guessing. Each becomes a real
# operational check only once you set it.
#
# Community Buy — how many hours a buyer may take to approve/reject a price
# change before it's treated as expired (spec §18.11). No default exists.
PRICE_APPROVAL_TIMEOUT_HOURS=
# Community Buy — fallback-only staleness signal for a supplier fulfilment
# with no estimatedReadyAt set at all (the primary delay check already
# compares against that real date). No default exists.
FULFILMENT_STALE_THRESHOLD_HOURS=
# Community Buy — how many hours a payout may sit in PENDING/IN_TRANSIT
# before ops treats it as stuck and worth investigating. No default exists.
PAYOUT_STUCK_THRESHOLD_HOURS=

# ─── Google / Apple Sign-In (server-side token verification) ────────────────
# The backend verifies a Google ID token's `aud` claim against one of these —
# whichever client (iOS, Android, or the web/Expo-proxy client) the token
# came from. At least one must be set for Google Sign-In to work at all;
# without any, provider-verify returns 503 "not configured".
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# The backend verifies an Apple identity token's `aud` claim against this —
# must exactly match the app's real iOS bundle identifier as registered with
# Apple. Required for Sign in with Apple; without it, provider-verify
# returns 503 "not configured".
APPLE_BUNDLE_ID=

# ─── Expo Push Notifications ─────────────────────────────────────────────────
# Required for mobile push in production (Expo's push service rate-limits/
# rejects unauthenticated senders past a low volume without this).
EXPO_ACCESS_TOKEN=

# ─── Logging ──────────────────────────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace. Defaults to "info".
LOG_LEVEL=info

# ─── API Docs ─────────────────────────────────────────────────────────────────
# Swagger UI is served by default. Set to "true" to disable it in production
# if you don't want the API surface publicly browsable.
DISABLE_DOCS=false

# ─── Admin 2FA ────────────────────────────────────────────────────────────────
# bcrypt cost factor for admin backup-code hashing. Defaults to 10 in
# production, 4 in the test env (kept fast on purpose there). Raise only if
# your ops team has a specific reason to.
ADMIN_2FA_BCRYPT_ROUNDS=10

# ─── Community Buy — explicit go-live gates ──────────────────────────────────
# Each of these defaults OFF (any value other than the literal string "true"
# is treated as not-confirmed) and unlocks one specific category of real
# money movement or PII exposure. Each is a genuine operational/legal
# confirmation, not a code readiness question — flip it only once the named
# precondition is actually true for your Stripe Connect setup.
#
# Requires Stripe Connect Direct Charge funds-segregation to be confirmed
# for AUTHORISE_THEN_CAPTURE-mode Community Buy markets before this backend
# is allowed to trigger a real payout (see campaign-payout.service.ts).
COMMUNITY_BUY_PAYOUT_CUSTODY_CONFIRMED=false
# Requires the same confirmation as above but for organiser (not supplier)
# payouts specifically — a separate Stripe Connect account/legal entity.
COMMUNITY_BUY_ORGANISER_PAYOUT_ENABLED=false
# Requires confirmation that organiser-fee settlement (the platform-vs-
# organiser fee split) has been reviewed and approved before it's allowed
# to actually settle real fee amounts.
COMMUNITY_BUY_ORGANISER_FEE_SETTLEMENT_CONFIRMED=false
# Requires the external DPIA + real courier-provider confirmation named in
# the Community Buy spec (§26) to actually happen before individual
# (non-collection) delivery is allowed at all — no courier/address-
# tokenisation integration is built, so this must stay false until one is.
COMMUNITY_BUY_INDIVIDUAL_DELIVERY_ENABLED=false
